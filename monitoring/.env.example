# Mode
COMPOSE_PROFILES=kms-local
KMS_MODE=local

# Telemetry metadata
KMS_CLUSTER=cosmian-kms-local
KMS_VERSION=5.29.0
ENVIRONMENT=demo

# Grafana (required: set before start)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# VictoriaMetrics
METRICS_RETENTION_MONTHS=12

# KMS (required: set before start)
KMS_P12_PASSWORD=
