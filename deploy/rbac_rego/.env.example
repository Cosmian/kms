# Copy to `.env` (git-ignored) before running `docker compose up`.
# Every value below is a demo placeholder: never reuse it outside this local stack.

# KMS image: build it once from the repository root with
#   mise run build:docker --variant fips --load
# then use the image name printed by that task (cosmian-kms:<version>-fips).
KMS_IMAGE=cosmian-kms:5.29.0-fips

# Keycloak bootstrap administrator (admin console: https://keycloak.localhost:8443/admin).
KC_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=kc-admin-demo-only-7f3a

# Password of the eight sample users of the `kms` realm (read by the realm import
# and by verify.sh). Users added later in the admin console choose their own.
# The realm password policy asks for at least 12 characters, not equal to the username or e-mail.
DEMO_USER_PASSWORD=rbac-demo-only-4b9e
