# Supply-chain policy (#1265). Kept here, not in pnpm-workspace.yaml: the Nix build's pnpm 9 rejects a settings-only workspace file.
# Refuse versions published less than 7 days ago (minutes).
minimum-release-age=10080
# Fail the install when a dependency has an install script not listed in onlyBuiltDependencies or ignoredBuiltDependencies.
strict-dep-builds=true
