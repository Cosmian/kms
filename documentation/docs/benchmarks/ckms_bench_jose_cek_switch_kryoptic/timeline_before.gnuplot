set terminal svg size 1000,500 enhanced font 'Helvetica,12'
set output 'timeline_before.svg'
set title 'before: message latency, all servers'
set grid
set xlabel 'seconds since the start of the measurement'
set ylabel 'message latency (ms, from scheduled time)'
set logscale y
set arrow from 20,graph 0 to 20,graph 1 nohead dashtype 2 lc rgb 'red'
set label 'CEK switch' at 20,graph 0.95 offset 1,0 textcolor rgb 'red'
