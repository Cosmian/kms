set terminal svg size 1000,500 enhanced font 'Helvetica,12'
set output 'timeline_local-r1200.svg'
set title 'local-r1200: message latency, all servers'
set grid
set xlabel 'seconds since the start of the measurement'
set ylabel 'message latency (ms, from scheduled time)'
set logscale y
set arrow from 10,graph 0 to 10,graph 1 nohead dashtype 2 lc rgb 'red'
set label 'CEK switch' at 10,graph 0.95 offset 1,0 textcolor rgb 'red'
