#!/bin/sh -ex

# Backup existing configuration
KMS_CONFIG="/etc/cosmian/kms.toml"
if [ -f $KMS_CONFIG ]; then
  mkdir -p /etc/cosmian
  timestamp=$(date '+%Y%m%d_%H%M%S')
  # Double backup just in case
  cp $KMS_CONFIG /etc/cosmian/"$timestamp"_kms.toml
  cp $KMS_CONFIG /etc/cosmian/kms.toml.bak
fi

# Backup existing UI branding overrides (if any)
UI_DIST="/usr/local/cosmian/ui/dist"
UI_BACKUP_DIR="/var/lib/cosmian/ui"
if [ -d "$UI_DIST" ]; then
  mkdir -p "$UI_BACKUP_DIR"
  if [ -f "$UI_DIST/branding.json" ]; then
    cp "$UI_DIST/branding.json" "$UI_BACKUP_DIR/branding.json.bak"
  fi
  if [ -d "$UI_DIST/themes" ]; then
    rm -rf "$UI_BACKUP_DIR/themes.bak"
    cp -R "$UI_DIST/themes" "$UI_BACKUP_DIR/themes.bak"
  fi
fi

# Record the service state across an upgrade. The postrm of <= 5.29.0 stops AND disables
# the unit during an upgrade (dpkg runs it after this preinst; 5.29.0 has no prerm, so the
# state is still intact here); postinst restores it from these markers.
STATE_DIR="/var/lib/cosmian"
rm -f "$STATE_DIR/upgrade-service-enabled" "$STATE_DIR/upgrade-service-active"
if [ "$1" = upgrade ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  mkdir -p "$STATE_DIR"
  if systemctl is-enabled --quiet cosmian_kms.service; then
    touch "$STATE_DIR/upgrade-service-enabled"
  fi
  if systemctl is-active --quiet cosmian_kms.service; then
    touch "$STATE_DIR/upgrade-service-active"
  fi
fi

