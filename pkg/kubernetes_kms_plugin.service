[Unit]
Description=Cosmian KMS Kubernetes Plugin
Documentation=https://docs.cosmian.com/integrations/kubernetes/kms-provider-plugin/
Requires=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/kubernetes-kms-plugin --config /etc/kubernetes-kms-plugin/config.yaml
Restart=on-failure
RestartSec=5s
StandardOutput=journal+console

# Runtime directory for the gRPC Unix socket.
# RuntimeDirectoryPreserve=yes is critical: the kube-apiserver mounts this
# directory as a hostPath volume. Without Preserve, systemd removes the
# directory (and its inode) on stop and recreates it on start. The container's
# bind-mount points to the old inode and becomes stale, preventing the apiserver
# from ever reaching the new socket. With Preserve=yes the same directory
# (same inode) is reused across stop/start cycles.
RuntimeDirectory=kubernetes-kms-plugin
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Hardening: Filesystem protections
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/kubernetes-kms-plugin /run/kubernetes-kms-plugin

# Hardening: Kernel protections
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

# Hardening: Device and control group protections
PrivateDevices=yes
ProtectControlGroups=yes
DevicePolicy=closed

# Hardening: Namespace restrictions
RestrictNamespaces=yes
PrivateUsers=no

# Hardening: Capability restrictions (plugin only needs outbound TCP/TLS to KMS
# and a Unix socket — no need to bind privileged ports)
CapabilityBoundingSet=
CapabilityBoundingSet=~CAP_SYS_ADMIN
CapabilityBoundingSet=~CAP_SYS_PTRACE
CapabilityBoundingSet=~CAP_SYS_RAWIO
CapabilityBoundingSet=~CAP_NET_BIND_SERVICE

# Hardening: System call filtering
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock
SystemCallFilter=~@cpu-emulation
SystemCallFilter=~@debug
SystemCallFilter=~@module
SystemCallFilter=~@mount
SystemCallFilter=~@obsolete
SystemCallFilter=~@raw-io
SystemCallFilter=~@reboot
SystemCallFilter=~@swap
SystemCallFilter=~ptrace

# Hardening: Network restrictions (outbound to KMS server + Unix socket)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Hardening: Misc protections
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
NoNewPrivileges=yes
UMask=0027

[Install]
WantedBy=multi-user.target
