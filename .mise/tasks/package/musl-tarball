#!/usr/bin/env bash
#MISE description="Build Alpine-compatible musl release tarball (server or CLI)"
#USAGE flag "-c --component <component>" env="COMPONENT" help="Binary to package" default="server" {
#USAGE   choices "server" "cli"
#USAGE }
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
set -euo pipefail
REPO_ROOT="${MISE_CONFIG_ROOT}"

exec bash "${REPO_ROOT}/.mise/scripts/package/package_musl_tarball.sh" \
  --component "${usage_component:-server}" \
  --variant "${usage_variant:-fips}"
