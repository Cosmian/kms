#!/usr/bin/env -S usage bash
#MISE description="Benchmark the JOSE caches (CEK cache in UnwrappedCache): same JOSE load sweep with the unwrapped cache ON then OFF"
#USAGE flag "-v --variant <v>"      env="BENCH_VARIANT"     default="non-fips"   help="FIPS variant" { choices "fips" "non-fips" }
#USAGE flag "-l --link <l>"         env="BENCH_LINK"        default="static"     help="Linkage type" { choices "static" "dynamic" }
#USAGE flag "-r --release"          env="BENCH_RELEASE"     default="true"       help="Build in release mode"
#USAGE flag "-t --time <t>"         env="BENCH_TIME"        default="20"         help="Measurement time per level (seconds)"
#USAGE flag "-c --concurrency <c>"  env="BENCH_CONCURRENCY" default="1,2,4,8,16" help="Comma-separated concurrency levels"
#USAGE flag "-W --warmup <s>"       env="BENCH_WARMUP"      default="5"          help="Warmup time before each level (seconds)"
#USAGE flag "-C --cooldown <s>"     env="BENCH_COOLDOWN"    default="2"          help="Cooldown between concurrency levels (seconds)"
#USAGE flag "-s --sanity"           env="BENCH_SANITY"                           help="Quick sanity: debug build, 2 s/level, concurrency=1,2, no warmup/cooldown; docs untouched"
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/kms_server.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/bench_helpers.sh"

# ── Resolve BENCH_ variables from usage-parsed lowercase names ──────────────────────
BENCH_VARIANT="${usage_variant:-non-fips}"
BENCH_LINK="${usage_link:-static}"
BENCH_RELEASE="${usage_release:-true}"
BENCH_TIME="${usage_time:-20}"
BENCH_CONCURRENCY="${usage_concurrency:-1,2,4,8,16}"
BENCH_WARMUP="${usage_warmup:-5}"
BENCH_COOLDOWN="${usage_cooldown:-2}"
BENCH_SANITY="${usage_sanity:-}"
# Read by bench_collect_env / bench_generate_report.
BENCH_MODE="encrypt"
BENCH_PROTOCOL="jose"
export BENCH_HSM_BACKEND="none"

kms_init_env "${BENCH_VARIANT}" "${BENCH_LINK}"
print_header "Running JOSE cache benchmark (${VARIANT_NAME})"

BUILD_MODE=$([ "${BENCH_RELEASE}" = "false" ] && echo debug || echo release)

# usage always resolves to "true" whether -s flag or BENCH_SANITY=1 env alias is used.
if [ "${BENCH_SANITY}" = "true" ]; then
  BUILD_MODE="debug"
  BENCH_TIME="2"
  BENCH_WARMUP="0"
  BENCH_COOLDOWN="0"
  BENCH_CONCURRENCY="1,2"
fi

TMP_DIR="$(mktemp -d /tmp/kms-bench-jose-cache-XXXXXX)"
bench_register_cleanup

bench_build_binaries "${BUILD_MODE}"
bench_warn_cpu_scaling

# run_cache_state <on|off>: fresh server from the fixture, JOSE load sweep, report.
run_cache_state() {
  local state="$1"
  local disabled=false
  [ "${state}" = off ] && disabled=true
  local work="${TMP_DIR}/${state}"
  mkdir -p "${work}/kms-data"
  cp "${MISE_CONFIG_ROOT}/test_data/configs/server/test/bench_jose_cache.toml" "${work}/kms.toml"

  KMS_PORT="$(kms_pick_free_port)"
  # shellcheck disable=SC2034  # read by kms_start_from_bin/kms_stop (sourced .mise/lib/kms_server.sh)
  KMS_URL="http://127.0.0.1:${KMS_PORT}"
  # shellcheck disable=SC2034  # same
  KMS_LOG_FILE="${work}/kms.log"
  set_toml_value "${work}/kms.toml" port "${KMS_PORT}"
  set_toml_value "${work}/kms.toml" sqlite_path "\"${work}/kms-data\""
  set_toml_value "${work}/kms.toml" disable_unwrapped_cache "${disabled}"
  kms_start_from_bin "${KMS_BIN}" --config "${work}/kms.toml"

  # Each state keeps its own data, including sanity runs.
  export CRITERION_HOME="${CARGO_TARGET_DIR}/criterion-jose-cache-${state}"
  rm -rf "${CRITERION_HOME}"
  mkdir -p "${CRITERION_HOME}"

  print_status "JOSE load sweep — unwrapped cache ${state} (disable_unwrapped_cache = ${disabled})"
  "${CKMS_BIN}" \
    --url "${KMS_URL}" \
    bench \
    --load \
    --mode encrypt \
    --protocol jose \
    --load-plaintext-size 4096 \
    --time "${BENCH_TIME}" \
    --load-concurrency "${BENCH_CONCURRENCY}" \
    --warmup-time "${BENCH_WARMUP}" \
    --cooldown-time "${BENCH_COOLDOWN}"

  BENCH_COMMAND_USED="mise run bench:jose-cache${usage_args:+ $usage_args} (unwrapped cache ${state})"
  export BENCH_COMMAND_USED
  export BENCH_JOSE_CACHE_STATE="${state}"
  # Must run while the server is still up: it queries /version.
  bench_generate_report "${KMS_PORT}" "ckms_bench_jose_cache_${state}"
  kms_stop
}

run_cache_state on
run_cache_state off

print_success "JOSE cache benchmark completed (reports: ckms_bench_jose_cache_on / ckms_bench_jose_cache_off)"
