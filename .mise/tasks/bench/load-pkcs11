#!/usr/bin/env -S usage bash
#MISE description="Run a real dlopen()-based PKCS#11 load benchmark against cosmian_pkcs11"
#USAGE flag "-v --variant <v>"      env="BENCH_VARIANT"       default="non-fips"       help="FIPS variant"                              { choices "fips" "non-fips" }
#USAGE flag "-l --link <l>"         env="BENCH_LINK"          default="static"          help="Linkage type"                              { choices "static" "dynamic" }
#USAGE flag "-r --release"          env="BENCH_RELEASE"       default="true"            help="Build optimized benchmark binaries (workspace bench profile: opt-level=3, debug symbols)"
#USAGE flag "-m --mode <m>"         env="BENCH_MODE"          default="all"             help="Benchmark mode"                            { choices "all" "encrypt" "decrypt" "sign" "verify" "sign-rsa" "verify-rsa" "sign-ecdsa" "verify-ecdsa" "sign-secp256k1" "verify-secp256k1" "sign-eddsa" "verify-eddsa" "key-creation" }
#USAGE flag "-t --time <t>"         env="BENCH_TIME"          default="20"              help="Measurement time per level (seconds)"
#USAGE flag "-c --concurrency <c>"  env="BENCH_CONCURRENCY"   default="1,2,4,8,16"  help="Comma-separated concurrency levels"
#USAGE flag "-u --server-url <u>"  env="BENCH_SERVER_URL"    default=""                help="Use an already-running KMS server at this URL instead of building/starting a temporary local one (e.g. a remote/non-local deployment). The cosmian_pkcs11 provider and pkcs11_bench binary are still built locally — only the KMS server itself is external."
#USAGE flag "-W --warmup <s>"       env="BENCH_WARMUP"        default="5"               help="Warmup time before the load sweep (seconds)"
#USAGE flag "-C --cooldown <s>"     env="BENCH_COOLDOWN"      default="2"               help="Cooldown between concurrency levels (seconds)"
#USAGE flag "-s --sanity"           env="BENCH_SANITY"                                  help="Quick sanity: 2 s/level, concurrency=1,2, no warmup/cooldown, mode=encrypt"
#USAGE flag "--shared-session"      env="BENCH_SHARED_SESSION"                          help="Force every worker thread to share one Cryptoki session (pre-fix behavior), instead of one dedicated session per thread (default) — for before/after comparison only"
#USAGE flag "--criterion"           env="BENCH_CRITERION"                               help="Also run real criterion-crate single-operation micro-benchmarks, on top of the concurrency sweep that always runs — writes criterion.json alongside load_pkcs11.json, so the report gets both a Load Tests and a Criterion Benchmarks section"
#USAGE flag "--speed <sp>"          env="BENCH_SPEED"         default="quick"           help="Criterion speed preset (with --criterion)" { choices "sanity" "quick" "normal" }
#USAGE flag "--overhead"            env="BENCH_OVERHEAD"                                help="Also run the Ed25519-specific differential overhead ladder (with --criterion) and write pkcs11_overhead.json — a standalone local diagnostic, never rendered into report.md"
#USAGE flag "--overhead-payload-size <n>" env="BENCH_OVERHEAD_PAYLOAD_SIZE" default="32" help="Ed25519 payload bytes for differential Criterion tiers (with --overhead)"
#USAGE flag "--overhead-payload-mode <m>" env="BENCH_OVERHEAD_PAYLOAD_MODE" default="fixed" help="Payload selection for typed and PKCS#11 Criterion tiers (with --overhead)" { choices "fixed" "varying" }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/bench_helpers.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/pkcs11_helpers.sh"

# ── Resolve BENCH_ variables from usage-parsed lowercase names ──────────────────────
BENCH_VARIANT="${usage_variant:-non-fips}"
BENCH_LINK="${usage_link:-static}"
BENCH_RELEASE="${usage_release:-true}"
BENCH_MODE="${usage_mode:-all}"
BENCH_TIME="${usage_time:-20}"
BENCH_CONCURRENCY="${usage_concurrency:-1,2,4,8,16}"
BENCH_SERVER_URL="${usage_server_url:-}"
BENCH_WARMUP="${usage_warmup:-5}"
BENCH_COOLDOWN="${usage_cooldown:-2}"
BENCH_SANITY="${usage_sanity:-}"
BENCH_SHARED_SESSION="${usage_shared_session:-}"
BENCH_CRITERION="${usage_criterion:-}"
BENCH_SPEED="${usage_speed:-quick}"
BENCH_OVERHEAD="${usage_overhead:-}"
BENCH_OVERHEAD_PAYLOAD_SIZE="${usage_overhead_payload_size:-32}"
BENCH_OVERHEAD_PAYLOAD_MODE="${usage_overhead_payload_mode:-fixed}"

kms_init_env "${BENCH_VARIANT}" "${BENCH_LINK}"
print_header "Running PKCS#11 load benchmark (${VARIANT_NAME})"
[ -n "${BENCH_SERVER_URL}" ] && echo "Target KMS server: ${BENCH_SERVER_URL} (external, not started by this task)"

# ── Variables ────────────────────────────────────────────────────────────────
TMP_DIR="$(mktemp -d /tmp/kms-bench-pkcs11-XXXXXX)"
if [ "${BENCH_RELEASE}" = "false" ]; then
  BUILD_MODE="debug"
  BUILD_DIR="debug"
  BUILD_PROFILE_ARGS=()
else
  # Workspace release optimizes for binary size (`opt-level = "z"`); benchmarks
  # must use the speed-oriented profile (`opt-level = 3`). Cargo writes this
  # built-in/custom bench profile to target/release.
  BUILD_MODE="bench"
  BUILD_DIR="release"
  BUILD_PROFILE_ARGS=(--profile bench)
fi

# Sanity: 2 s/level, concurrency=1,2, no warmup/cooldown, mode=encrypt.
# usage always resolves to "true" whether -s flag or BENCH_SANITY=1 env alias is used.
if [ "${BENCH_SANITY}" = "true" ]; then
  BUILD_MODE="debug"
  BUILD_DIR="debug"
  BUILD_PROFILE_ARGS=()
  BENCH_TIME="2"
  BENCH_WARMUP="0"
  BENCH_COOLDOWN="0"
  BENCH_MODE="encrypt"
  BENCH_CONCURRENCY="1,2"
fi

bench_register_cleanup

# Build the server (if local), the cosmian_pkcs11 cdylib, and the benchmark binary.
BUILD_ARGS=(-p cosmian_pkcs11 -p cosmian_pkcs11_bench)
[ -z "${BENCH_SERVER_URL}" ] && BUILD_ARGS=(-p cosmian_kms_server "${BUILD_ARGS[@]}")
BUILD_FEATURES=()
[ "${BENCH_VARIANT}" = "non-fips" ] && BUILD_FEATURES+=(non-fips)
# The `benchmarking` feature only powers the Ed25519 overhead ladder's internal
# phase counters (`overhead.rs`/`profiling.rs`), so it is only needed for
# `--overhead`, not for every `--criterion` run.
[ "${BENCH_OVERHEAD}" = "true" ] && BUILD_FEATURES+=(cosmian_pkcs11/benchmarking)
BUILD_FEATURE_ARGS=()
if [ "${#BUILD_FEATURES[@]}" -gt 0 ]; then
  BUILD_FEATURE_LIST=$(IFS=,; echo "${BUILD_FEATURES[*]}")
  BUILD_FEATURE_ARGS=(--features "${BUILD_FEATURE_LIST}")
fi
echo "Building cosmian_kms server, cosmian_pkcs11 provider, and the PKCS#11 benchmark (${BUILD_MODE})..."
cargo build "${BUILD_ARGS[@]}" ${BUILD_PROFILE_ARGS[@]+"${BUILD_PROFILE_ARGS[@]}"} \
  ${BUILD_FEATURE_ARGS[@]+"${BUILD_FEATURE_ARGS[@]}"}

# shellcheck disable=SC2119
CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$(get_repo_root)/target}"
export CARGO_TARGET_DIR
KMS_BIN="${CARGO_TARGET_DIR}/${BUILD_DIR}/cosmian_kms"
PKCS11_BENCH_BIN="${CARGO_TARGET_DIR}/${BUILD_DIR}/pkcs11_bench"
export KMS_BIN

PKCS11_LIB="$(get_cosmian_pkcs11_lib "${CARGO_TARGET_DIR}" "${BUILD_DIR}")"

if [ -n "${BENCH_SERVER_URL}" ]; then
  KMS_BASE_URL="${BENCH_SERVER_URL%/}"
  echo "Using existing KMS server at ${KMS_BASE_URL} (no local server will be started)..."
  # Reuse kms_wait_ready's polling/error-reporting for a fast, clear failure if the
  # remote server is unreachable, instead of letting pkcs11_bench fail deep inside
  # its own key-provisioning step with a cryptic error. Pass "$$" (this script's own
  # always-alive PID) as the "kms_pid" arg: kms_wait_ready's early-exit branch only
  # fires when that PID has died, which correctly never happens here — we are not
  # tracking/owning the remote process. /dev/null stands in for the log file kms_wait_ready
  # dumps on timeout, since there is no local server log for a remote server.
  kms_wait_ready "${KMS_BASE_URL}/kmip/2_1" "$$" /dev/null 15
else
  BENCH_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')
  bench_start_server "$BENCH_PORT" "$TMP_DIR"
  KMS_BASE_URL="http://127.0.0.1:${BENCH_PORT}"
fi

# The cosmian_pkcs11 provider resolves its own KMS server URL from a ckms.toml
# (CKMS_CONF env var > ckms.toml next to the DLL > default search path) — it does
# NOT read the benchmark binary's --kms-url flag. Without this, C_Initialize would
# connect to the default http://localhost:9998 instead of the temporary server
# started above.
CKMS_CONF="${TMP_DIR}/ckms.toml"
cat >"${CKMS_CONF}" <<EOF
[http_config]
server_url = "${KMS_BASE_URL}"
EOF
export CKMS_CONF

# CRITERION_HOME is where the benchmark binary writes load_pkcs11.json and where
# bench_generate_report reads it from — same variable, same directory convention as
# `bench/load` and `bench/load-hsm`. Always start from a clean slate so results are
# never mixed with output from another bench task's earlier run.
export CRITERION_HOME="${CRITERION_HOME:-${CARGO_TARGET_DIR}/criterion}"
echo "Cleaning ${CRITERION_HOME}..."
rm -rf "${CRITERION_HOME}"
mkdir -p "${CRITERION_HOME}"

bench_warn_cpu_scaling

# BENCH_PROTOCOL feeds bench_collect_env's "Load test parameters" table (via
# bench_generate_report below, called later in this script) — there is only one
# "protocol" here: the real PKCS#11 Cryptoki C ABI, dlopen()-ed directly, not any
# KMIP wire protocol.
# shellcheck disable=SC2034  # read by bench_collect_env (sourced from bench_helpers.sh) as a global
BENCH_PROTOCOL="pkcs11"

SHARED_SESSION_ARGS=()
[ "${BENCH_SHARED_SESSION}" = "true" ] && SHARED_SESSION_ARGS+=(--shared-session)

CRITERION_ARGS=()
if [ "${BENCH_CRITERION}" = "true" ]; then
  CRITERION_ARGS+=(
    --criterion
    --speed "${BENCH_SPEED}"
    --overhead-payload-size "${BENCH_OVERHEAD_PAYLOAD_SIZE}"
    --overhead-payload-mode "${BENCH_OVERHEAD_PAYLOAD_MODE}"
  )
  [ "${BENCH_OVERHEAD}" = "true" ] && CRITERION_ARGS+=(--overhead)
fi

"${PKCS11_BENCH_BIN}" \
  --pkcs11-lib "${PKCS11_LIB}" \
  --kms-url "${KMS_BASE_URL}" \
  --mode "${BENCH_MODE}" \
  --concurrency "${BENCH_CONCURRENCY}" \
  --time "${BENCH_TIME}" \
  --warmup "${BENCH_WARMUP}" \
  --cooldown "${BENCH_COOLDOWN}" \
  ${SHARED_SESSION_ARGS[@]+"${SHARED_SESSION_ARGS[@]}"} \
  ${CRITERION_ARGS[@]+"${CRITERION_ARGS[@]}"}

# Dedicated report directory (documentation/docs/benchmarks/ckms_bench_pkcs11/) so
# this never clobbers the ckms_bench / ckms_bench_hsm_kek / ckms_bench_hsm reports
# generated by bench/load and bench/load-hsm. is_pkcs11=true selects the PKCS#11
# Protocols/Methodology report text in plot_version_compare.py instead of the
# generic KMIP-wire-protocol text.
bench_generate_report "${BENCH_PORT:-0}" "ckms_bench_pkcs11" "false" "false" "true" "${KMS_BASE_URL}"

print_success "PKCS#11 load benchmark completed"
