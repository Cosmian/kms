#!/usr/bin/env -S usage bash
#MISE description="Run a real dlopen()-based PKCS#11 load benchmark against cosmian_pkcs11"
#USAGE flag "-v --variant <v>"      env="BENCH_VARIANT"       default="non-fips"       help="FIPS variant"                              { choices "fips" "non-fips" }
#USAGE flag "-l --link <l>"         env="BENCH_LINK"          default="static"          help="Linkage type"                              { choices "static" "dynamic" }
#USAGE flag "-r --release"          env="BENCH_RELEASE"       default="true"            help="Build optimized benchmark binaries (workspace bench profile: opt-level=3, debug symbols)"
#USAGE flag "-m --mode <m>"         env="BENCH_MODE"          default="all"             help="Benchmark mode"                            { choices "all" "encrypt" "key-creation" "sign-verify" "batch" }
#USAGE flag "-a --algorithm <a>"    env="BENCH_ALGORITHM"     default=""                help="Filter algorithms by substring, comma-separated (e.g. ecdsa,eddsa)"
#USAGE flag "-t --time <t>"         env="BENCH_TIME"          default="20"              help="Measurement time per level (seconds)"
#USAGE flag "-c --concurrency <c>"  env="BENCH_CONCURRENCY"   default="1,2,4,8,16"  help="Comma-separated concurrency levels"
#USAGE flag "-w --http-workers <n>" env="BENCH_HTTP_WORKERS"  default=""            help="Number of Actix-web HTTP worker threads (empty = server default: total logical core count)"
#USAGE flag "-u --server-url <u>"  env="BENCH_SERVER_URL"    default=""                help="Use an already-running KMS server at this URL instead of building/starting a temporary local one (e.g. a remote/non-local deployment). The cosmian_pkcs11 provider and ckms binary are still built locally — only the KMS server itself is external."
#USAGE flag "--accept-invalid-certs"  env="BENCH_ACCEPT_INVALID_CERTS"                 help="Allow connecting to an HTTPS KMS server with an untrusted or self-signed certificate"
#USAGE flag "--tls-ca-cert <p>"       env="BENCH_TLS_CA_CERT"                          help="Path to a PEM-encoded CA certificate file used to verify the KMS server certificate (used for the provider ckms.toml)"
#USAGE flag "--tls-client-pem-cert <p>" env="BENCH_TLS_CLIENT_PEM_CERT"                help="Path to a client certificate in PEM format for mutual TLS authentication (used for the provider ckms.toml)"
#USAGE flag "--tls-client-pem-key <p>"  env="BENCH_TLS_CLIENT_PEM_KEY"                 help="Path to a client private key in PEM format for mutual TLS authentication (used for the provider ckms.toml)"
#USAGE flag "--tls-client-pkcs12 <p>"   env="BENCH_TLS_CLIENT_PKCS12"                  help="Path to a client PKCS#12 archive (.p12 / .pfx) for mutual TLS authentication (used for the provider ckms.toml)"
#USAGE flag "--tls-client-pkcs12-password <s>" env="BENCH_TLS_CLIENT_PKCS12_PASSWORD" help="Password for the client PKCS#12 archive (used for the provider ckms.toml)"
#USAGE flag "-W --warmup <s>"       env="BENCH_WARMUP"        default="5"               help="Warmup time before the load sweep (seconds)"
#USAGE flag "-C --cooldown <s>"     env="BENCH_COOLDOWN"      default="2"               help="Cooldown between concurrency levels (seconds)"
#USAGE flag "-s --sanity"           env="BENCH_SANITY"                                  help="Quick sanity: 2 s/level, concurrency=1,2, no warmup/cooldown, mode=encrypt"
#USAGE flag "--shared-session"      env="BENCH_SHARED_SESSION"                          help="Force every worker thread to share one Cryptoki session (pre-fix behavior), instead of one dedicated session per thread (default) — for before/after comparison only"
#USAGE flag "-d --delegated"        env="BENCH_DELEGATED"                               help="Benchmark crypto operations executed DIRECTLY on the HSM (CryptoOracle) via HSM-resident keys"
#USAGE flag "--hsm-model <m>"        env="BENCH_HSM_MODEL"     default="softhsm2"        help="HSM model for delegated benchmarking"      { choices "softhsm2" "kryoptic" "proteccio" "crypt2pay" "utimaco" "smartcardhsm" "aws_cloudhsm" "other" }
#USAGE flag "--hsm-slot <s>"          env="BENCH_HSM_SLOT"                                 help="HSM slot ID for HSM-resident keys (used with --delegated and remote --server-url)"
#USAGE flag "--criterion"           env="BENCH_CRITERION"                               help="Also run real criterion-crate single-operation micro-benchmarks, on top of the concurrency sweep that always runs — writes criterion.json alongside load_pkcs11.json, so the report gets both a Load Tests and a Criterion Benchmarks section"
#USAGE flag "--speed <speed>"         env="BENCH_SPEED"         default="quick"           help="Criterion speed preset (with --criterion)" { choices "sanity" "quick" "normal" }
#USAGE flag "--overhead"            env="BENCH_OVERHEAD"                                help="Also run the Ed25519-specific differential overhead ladder (with --criterion) and write pkcs11_overhead.json — a standalone local diagnostic, never rendered into report.md"
#USAGE flag "--overhead-payload-size <n>" env="BENCH_OVERHEAD_PAYLOAD_SIZE" default="32" help="Ed25519 payload bytes for differential Criterion tiers (with --overhead)"
#USAGE flag "--overhead-payload-mode <m>" env="BENCH_OVERHEAD_PAYLOAD_MODE" default="fixed" help="Payload selection for typed and PKCS#11 Criterion tiers (with --overhead)" { choices "fixed" "varying" }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/bench_helpers.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/pkcs11_helpers.sh"

# ── Resolve BENCH_ variables from usage-parsed lowercase names ──────────────────────
BENCH_VARIANT="${usage_variant:-non-fips}"
BENCH_LINK="${usage_link:-static}"
BENCH_RELEASE="${usage_release:-true}"
BENCH_MODE="${usage_mode:-all}"
BENCH_ALGORITHM="${usage_algorithm:-}"
BENCH_TIME="${usage_time:-20}"
BENCH_CONCURRENCY="${usage_concurrency:-1,2,4,8,16}"
BENCH_HTTP_WORKERS="${usage_http_workers:-}"
BENCH_SERVER_URL="${usage_server_url:-}"
BENCH_ACCEPT_INVALID_CERTS="${usage_accept_invalid_certs:-}"
BENCH_TLS_CA_CERT="${usage_tls_ca_cert:-}"
BENCH_TLS_CLIENT_PEM_CERT="${usage_tls_client_pem_cert:-}"
BENCH_TLS_CLIENT_PEM_KEY="${usage_tls_client_pem_key:-}"
BENCH_TLS_CLIENT_PKCS12="${usage_tls_client_pkcs12:-}"
BENCH_TLS_CLIENT_PKCS12_PASSWORD="${usage_tls_client_pkcs12_password:-}"
BENCH_WARMUP="${usage_warmup:-5}"
BENCH_COOLDOWN="${usage_cooldown:-2}"
BENCH_SANITY="${usage_sanity:-}"
BENCH_SHARED_SESSION="${usage_shared_session:-}"
BENCH_DELEGATED="${usage_delegated:-}"
BENCH_HSM_MODEL="${usage_hsm_model:-softhsm2}"
BENCH_HSM_SLOT="${usage_hsm_slot:-}"
BENCH_CRITERION="${usage_criterion:-}"
BENCH_SPEED="${usage_speed:-quick}"
BENCH_OVERHEAD="${usage_overhead:-}"
BENCH_OVERHEAD_PAYLOAD_SIZE="${usage_overhead_payload_size:-32}"
BENCH_OVERHEAD_PAYLOAD_MODE="${usage_overhead_payload_mode:-fixed}"


if [ "${BENCH_DELEGATED}" = "true" ]; then
  if [ -n "${BENCH_SERVER_URL}" ]; then
    if [ -z "${BENCH_HSM_SLOT}" ]; then
      print_error "--hsm-slot is required when using --delegated with --server-url."
    fi
    SOFTHSM2_HSM_SLOT_ID="${BENCH_HSM_SLOT}"
  elif [ "${BENCH_HSM_MODEL}" = "kryoptic" ]; then
    source "${MISE_CONFIG_ROOT}/.mise/lib/kryoptic.sh"
    SOFTHSM2_HSM_SLOT_ID=1
  elif [ "${BENCH_HSM_MODEL}" = "softhsm2" ]; then
    source "${MISE_CONFIG_ROOT}/.mise/lib/softhsm2.sh"
  fi
fi
kms_init_env "${BENCH_VARIANT}" "${BENCH_LINK}"
if [ "${BENCH_DELEGATED}" = "true" ]; then
  print_header "Running HSM-delegated PKCS#11 load benchmark (${VARIANT_NAME})"
else
  print_header "Running PKCS#11 load benchmark (${VARIANT_NAME})"
fi
[ -n "${BENCH_SERVER_URL}" ] && print_status "Target KMS server: ${BENCH_SERVER_URL} (external, not started by this task)"

# ── Variables ────────────────────────────────────────────────────────────────
TMP_DIR="$(mktemp -d /tmp/kms-bench-pkcs11-XXXXXX)"
if [ "${BENCH_RELEASE}" = "false" ]; then
  BUILD_MODE="debug"
  BUILD_DIR="debug"
  BUILD_PROFILE_ARGS=()
else
  # Workspace release optimizes for binary size (`opt-level = "z"`); benchmarks
  # must use the speed-oriented profile (`opt-level = 3`). Cargo writes this
  # built-in/custom bench profile to target/release.
  BUILD_MODE="bench"
  BUILD_DIR="release"
  BUILD_PROFILE_ARGS=(--profile bench)
fi

# Sanity: 2 s/level, concurrency=1,2, no warmup/cooldown, mode=encrypt.
# usage always resolves to "true" whether -s flag or BENCH_SANITY=1 env alias is used.
if [ "${BENCH_SANITY}" = "true" ]; then
  BUILD_MODE="debug"
  BUILD_DIR="debug"
  BUILD_PROFILE_ARGS=()
  BENCH_TIME="2"
  BENCH_WARMUP="0"
  BENCH_COOLDOWN="0"
  BENCH_MODE="encrypt"
  BENCH_CONCURRENCY="1,2"
fi

bench_register_cleanup

# Build the server (if local), the cosmian_pkcs11 cdylib, and the ckms binary.
BUILD_ARGS=(-p cosmian_pkcs11 -p ckms)
if [ -z "${BENCH_SERVER_URL}" ] || [ "${BENCH_DELEGATED}" = "true" ]; then
  BUILD_ARGS=(-p cosmian_kms_server "${BUILD_ARGS[@]}")
fi
BUILD_FEATURES=()
[ "${BENCH_VARIANT}" = "non-fips" ] && BUILD_FEATURES+=(non-fips)
BUILD_FEATURE_ARGS=()
if [ "${#BUILD_FEATURES[@]}" -gt 0 ]; then
  BUILD_FEATURE_LIST=$(IFS=,; echo "${BUILD_FEATURES[*]}")
  BUILD_FEATURE_ARGS=(--features "${BUILD_FEATURE_LIST}")
fi
echo "Building cosmian_kms server, cosmian_pkcs11 provider, and the PKCS#11 benchmark (${BUILD_MODE})..."
cargo build "${BUILD_ARGS[@]}" ${BUILD_PROFILE_ARGS[@]+"${BUILD_PROFILE_ARGS[@]}"} \
  ${BUILD_FEATURE_ARGS[@]+"${BUILD_FEATURE_ARGS[@]}"}

# shellcheck disable=SC2119
CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$(get_repo_root)/target}"
export CARGO_TARGET_DIR
KMS_BIN="${CARGO_TARGET_DIR}/${BUILD_DIR}/cosmian_kms"
CKMS_BIN="${CARGO_TARGET_DIR}/${BUILD_DIR}/ckms"
export CKMS_BIN
export KMS_BIN

PKCS11_LIB="$(get_cosmian_pkcs11_lib "${CARGO_TARGET_DIR}" "${BUILD_DIR}")"

if [ "${BENCH_DELEGATED}" != "true" ] || [ -n "${BENCH_SERVER_URL}" ]; then
  if [ -n "${BENCH_SERVER_URL}" ]; then
    KMS_BASE_URL="${BENCH_SERVER_URL%/}"
    print_status "Using existing KMS server at ${KMS_BASE_URL}"
    bench_wait_ready_tls "${KMS_BASE_URL}/kmip/2_1" "${BENCH_ACCEPT_INVALID_CERTS}" "${BENCH_TLS_CA_CERT}" "${BENCH_TLS_CLIENT_PEM_CERT}" "${BENCH_TLS_CLIENT_PEM_KEY}" 15
  else
    BENCH_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')
    bench_start_server "${BENCH_PORT}" "${TMP_DIR}" "${BENCH_HTTP_WORKERS}"
    KMS_BASE_URL="http://127.0.0.1:${BENCH_PORT}"
  fi

  # The provider resolves its server from CKMS_CONF, not the benchmark's --url.
  CKMS_CONF="${TMP_DIR}/ckms.toml"
  bench_write_ckms_tls_conf "${CKMS_CONF}" "${KMS_BASE_URL}" "${BENCH_ACCEPT_INVALID_CERTS}" \
    "${BENCH_TLS_CA_CERT}" "${BENCH_TLS_CLIENT_PEM_CERT}" "${BENCH_TLS_CLIENT_PEM_KEY}" \
    "${BENCH_TLS_CLIENT_PKCS12}" "${BENCH_TLS_CLIENT_PKCS12_PASSWORD}"
  export CKMS_CONF
fi
# CRITERION_HOME is where the benchmark binary writes load_pkcs11.json and where
# bench_generate_report reads it from — same variable, same directory convention as
# `bench/load` and `bench/load-hsm`. Always start from a clean slate so results are
# never mixed with output from another bench task's earlier run.
export CRITERION_HOME="${CRITERION_HOME:-${CARGO_TARGET_DIR}/criterion}"
echo "Cleaning ${CRITERION_HOME}..."
rm -rf "${CRITERION_HOME}"
mkdir -p "${CRITERION_HOME}"

bench_warn_cpu_scaling

# BENCH_PROTOCOL feeds bench_collect_env's "Load test parameters" table (via
# bench_generate_report below, called later in this script) — there is only one
# "protocol" here: the real PKCS#11 Cryptoki C ABI, dlopen()-ed directly, not any
# KMIP wire protocol.
# shellcheck disable=SC2034  # read by bench_collect_env (sourced from bench_helpers.sh) as a global
BENCH_PROTOCOL="pkcs11"

SHARED_SESSION_ARGS=()
[ "${BENCH_SHARED_SESSION}" = "true" ] && SHARED_SESSION_ARGS+=(--shared-session)

CRITERION_ARGS=()
if [ "${BENCH_CRITERION}" = "true" ]; then
  CRITERION_ARGS+=(
    --criterion
    --speed "${BENCH_SPEED}"
    --overhead-payload-size "${BENCH_OVERHEAD_PAYLOAD_SIZE}"
    --overhead-payload-mode "${BENCH_OVERHEAD_PAYLOAD_MODE}"
  )
  [ "${BENCH_OVERHEAD}" = "true" ] && CRITERION_ARGS+=(--overhead)
fi

ACCEPT_INVALID_CERTS_ARGS=()
[ "${BENCH_ACCEPT_INVALID_CERTS}" = "true" ] && ACCEPT_INVALID_CERTS_ARGS+=(--accept-invalid-certs)

ALGORITHM_ARGS=()
[ -n "${BENCH_ALGORITHM}" ] && ALGORITHM_ARGS+=(--algorithm "${BENCH_ALGORITHM}")
run_pkcs11_bench() {
  local base_url="$1" conf="$2" mode="$3"
  local delegated_args=()
  if [ "${BENCH_DELEGATED}" = "true" ]; then
    delegated_args=(--delegated --hsm-slot "${SOFTHSM2_HSM_SLOT_ID}")
  fi

  "${CKMS_BIN}" \
    --url "${base_url}" \
    ${ACCEPT_INVALID_CERTS_ARGS[@]+"${ACCEPT_INVALID_CERTS_ARGS[@]}"} \
    pkcs11 bench \
    --dll "${PKCS11_LIB}" \
    --conf "${conf}" \
    --mode "${mode}" \
    --concurrency "${BENCH_CONCURRENCY}" \
    --time "${BENCH_TIME}" \
    --warmup "${BENCH_WARMUP}" \
    --cooldown "${BENCH_COOLDOWN}" \
    ${delegated_args[@]+"${delegated_args[@]}"} \
    ${SHARED_SESSION_ARGS[@]+"${SHARED_SESSION_ARGS[@]}"} \
    ${CRITERION_ARGS[@]+"${CRITERION_ARGS[@]}"} \
    ${ALGORITHM_ARGS[@]+"${ALGORITHM_ARGS[@]}"}
}
if [ "${BENCH_DELEGATED}" = "true" ] && [ -z "${BENCH_SERVER_URL}" ] && [ "${BENCH_MODE}" = "all" ]; then
  CRITERION_ROOT="${CRITERION_HOME}"
  MERGED_DIR="${TMP_DIR}/merged"
  mkdir -p "${MERGED_DIR}"
  SUB_MODES="key-creation encrypt sign-verify"
  SUB_COUNT=$(printf '%s\n' "${SUB_MODES}" | wc -w)
  SUB_INDEX=0
  for SUB_MODE in ${SUB_MODES}; do
    SUB_INDEX=$((SUB_INDEX + 1))
    SUB_TMP="${TMP_DIR}/${SUB_MODE}"
    mkdir -p "${SUB_TMP}"
    SUB_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')
    print_status "[${SUB_INDEX}/${SUB_COUNT}] delegated PKCS#11 submode: ${SUB_MODE}"
    bench_start_server_hsm_resident "${SUB_PORT}" "${SUB_TMP}" "${BENCH_HTTP_WORKERS}" "${BENCH_HSM_MODEL}" "${BENCH_HSM_SLOT}"
    KMS_BASE_URL="http://127.0.0.1:${SUB_PORT}"
    CKMS_CONF="${SUB_TMP}/ckms.toml"
    bench_write_ckms_tls_conf "${CKMS_CONF}" "${KMS_BASE_URL}" "false" "" "" "" "" ""
    export CKMS_CONF
    export CRITERION_HOME="${CRITERION_ROOT}/${SUB_MODE}"
    rm -rf "${CRITERION_HOME}"
    mkdir -p "${CRITERION_HOME}"

    if ! run_pkcs11_bench "${KMS_BASE_URL}" "${CKMS_CONF}" "${SUB_MODE}"; then
      cat "${SUB_TMP}/kms.log" >&2 || true
      exit 1
    fi
    [ -f "${CRITERION_HOME}/load_pkcs11.json" ] && cat "${CRITERION_HOME}/load_pkcs11.json" >>"${MERGED_DIR}/load_pkcs11.json"
    [ -f "${CRITERION_HOME}/criterion.json" ] && cat "${CRITERION_HOME}/criterion.json" >>"${MERGED_DIR}/criterion.json"

    if [ "${SUB_INDEX}" -lt "${SUB_COUNT}" ]; then
      bench_stop_server
    else
      BENCH_PORT="${SUB_PORT}"
    fi
  done

  export CRITERION_HOME="${CRITERION_ROOT}"
  cp "${MERGED_DIR}"/* "${CRITERION_HOME}/"
elif [ "${BENCH_DELEGATED}" = "true" ] && [ -z "${BENCH_SERVER_URL}" ]; then
  BENCH_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')
  bench_start_server_hsm_resident "${BENCH_PORT}" "${TMP_DIR}" "${BENCH_HTTP_WORKERS}" "${BENCH_HSM_MODEL}" "${BENCH_HSM_SLOT}"
  KMS_BASE_URL="http://127.0.0.1:${BENCH_PORT}"
  CKMS_CONF="${TMP_DIR}/ckms.toml"
  bench_write_ckms_tls_conf "${CKMS_CONF}" "${KMS_BASE_URL}" "false" "" "" "" "" ""
  export CKMS_CONF
  if ! run_pkcs11_bench "${KMS_BASE_URL}" "${CKMS_CONF}" "${BENCH_MODE}"; then
    cat "${TMP_DIR}/kms.log" >&2 || true
    exit 1
  fi
elif [ "${BENCH_DELEGATED}" = "true" ]; then
  BENCH_PORT=0
  run_pkcs11_bench "${KMS_BASE_URL}" "${CKMS_CONF}" "${BENCH_MODE}"
else
  run_pkcs11_bench "${KMS_BASE_URL}" "${CKMS_CONF}" "${BENCH_MODE}"
fi

if [ "${BENCH_DELEGATED}" = "true" ]; then
  bench_generate_report "${BENCH_PORT}" "ckms_bench_pkcs11_delegated" "true" "false" "true" "${KMS_BASE_URL}"
  print_success "HSM-delegated PKCS#11 load benchmark completed"
else
  bench_generate_report "${BENCH_PORT:-0}" "ckms_bench_pkcs11" "false" "false" "true" "${KMS_BASE_URL}"
  print_success "PKCS#11 load benchmark completed"
fi
