#!/usr/bin/env bash
#MISE description="Run CI sanity benchmark"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#USAGE flag "-P --protocol <protocol>" env="BENCH_PROTOCOL" help="Protocol to benchmark" default="all" {
#USAGE   choices "all" "ttlv-json" "ttlv-bytes" "jose"
#USAGE }
#USAGE flag "-m --mode <mode>" env="BENCH_MODE" help="Benchmark mode" default="all" {
#USAGE   choices "all" "encrypt" "key-creation" "sign-verify" "batch"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/bench_helpers.sh"
kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"

print_header "Running CI sanity benchmark (${VARIANT_NAME})"

# shellcheck disable=SC2034  # REPO_ROOT used by sourced bench helper functions
REPO_ROOT="$(get_repo_root)"
TMP_DIR="$(mktemp -d /tmp/kms-bench-XXXXXX)"
bench_register_cleanup

bench_build_binaries "debug"
BENCH_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')
bench_start_server "$BENCH_PORT" "$TMP_DIR"

export CRITERION_HOME="${CRITERION_HOME:-${CARGO_TARGET_DIR}/criterion}"

"${CKMS_BIN}" --url "http://127.0.0.1:${BENCH_PORT}" bench \
  --speed sanity \
  --format json \
  --warmup-time 0 \
  --mode "${usage_mode:-all}" \
  --protocol "${usage_protocol:-all}"

bench_generate_report "${BENCH_PORT}"

print_success "CI benchmark completed"
