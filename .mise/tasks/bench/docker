#!/usr/bin/env bash
#MISE description="Benchmark ckms against Dockerized KMS versions"
#USAGE arg "<version_spec>" help="Version or range (e.g. 5.17, 5.12..5.17, '5.14.0 5.17.0')" default="5.17"
#USAGE flag "--compare <version>" help="Compare version (two-version diff mode)"
#USAGE flag "--mode <mode>" help="Benchmark mode" default="all" {
#USAGE   choices "all" "symmetric" "asymmetric" "certificates"
#USAGE }
#USAGE flag "--speed <speed>" help="Benchmark speed" default="quick" {
#USAGE   choices "quick" "normal" "thorough"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

print_header "Docker Benchmark (version: ${usage_version_spec:-5.17})"

require_cmd docker "Docker is required to pull KMS images."
require_cmd cargo "Cargo is required to build ckms bench."

ARGS=("${usage_version_spec:-5.17}")
[ -n "${usage_compare:-}" ] && ARGS+=("$usage_compare")

export BENCH_MODE="${usage_mode:-all}"
export EXTRA_ARGS="--speed ${usage_speed:-quick}"

bash "${MISE_CONFIG_ROOT}/.mise/scripts/bench/docker/bench_docker.sh" "${ARGS[@]}"

print_success "Docker benchmark completed"
