#!/usr/bin/env bash
#MISE description="Regenerate all documentation (server help, ckms markdown, KMIP tables, CBOM)"
#USAGE arg "[task]" help="Documentation task to run (default: all)" default="all" {
#USAGE   choices "all" "server-docs" "ckms-docs" "kmip-tables" "crypto-inventory" "cbom" "log-index"
#USAGE }
#USAGE flag "--skip-cbom" help="Skip CBOM generation"
#USAGE flag "--skip-crypto" help="Skip cryptographic inventory generation"
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

print_header "Generating documentation"

REPO_ROOT="$(get_repo_root)"

ARGS=()
if [ "${usage_task:-all}" != "all" ]; then
  ARGS+=("${usage_task}")
fi
if [ "${usage_skip_cbom:-false}" = "true" ]; then
  ARGS+=(--skip-cbom)
fi
if [ "${usage_skip_crypto:-false}" = "true" ]; then
  ARGS+=(--skip-crypto)
fi

bash "${REPO_ROOT}/.mise/scripts/docs/generate_docs.sh" "${ARGS[@]}"

print_success "Documentation generated"
