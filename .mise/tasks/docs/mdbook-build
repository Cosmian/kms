#!/usr/bin/env bash
#MISE description="Build the KMS documentation site with mdBook"
#USAGE flag "--combined" help="Also build the public combined docs with this checkout and the other products' staging branches (on in CI when PUBLIC_DOCS_TOKEN is set)"
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

# Only used to clone the private public_documentation repo: keep it away from the build tools
TOKEN="${PUBLIC_DOCS_TOKEN:-}"
unset PUBLIC_DOCS_TOKEN

print_header "Building KMS documentation"

REPO_ROOT="$(get_repo_root)"

# Keep these versions synchronized with documentation/theme/scripts/setup-mdbook.sh:6-8.
if [[ "$(mdbook --version 2>/dev/null || true)" != "mdbook v0.4.52" ]] ||
  [[ "$(mdbook-admonish --version 2>/dev/null || true)" != "mdbook-admonish 1.20.0" ]] ||
  [[ "$(mdbook-mermaid --version 2>/dev/null || true)" != "mdbook-mermaid 0.16.0" ]]; then
  # The theme script bootstraps rustup with `curl | sh` when cargo is missing: never reach it from here.
  command -v cargo >/dev/null 2>&1 ||
    print_error "mdBook toolchain missing or outdated and cargo is not on PATH: install Rust (https://rustup.rs) or the pinned mdbook, mdbook-admonish and mdbook-mermaid versions"
  print_info "Installing pinned mdBook toolchain..."
  bash "${REPO_ROOT}/documentation/theme/scripts/setup-mdbook.sh"
fi

cd "${REPO_ROOT}/documentation"
mdbook build

print_success "Documentation built → documentation/book/html/"

if [ "${usage_combined:-false}" = "true" ] || [ -n "${TOKEN}" ]; then
  # Disposable checkout outside the repo: build-staging.sh resets the other products in it
  PUBLIC_DOCS_DIR="${PUBLIC_DOCS_DIR:-$(mktemp -d)/public_documentation}"
  if [ ! -d "${PUBLIC_DOCS_DIR}" ]; then
    clone=(clone --depth 1 --recurse-submodules --shallow-submodules
      git@github.com:Cosmian/public_documentation.git "${PUBLIC_DOCS_DIR}")
    if [ -n "${TOKEN}" ]; then
      # CI has no SSH key: HTTPS with the token, theme submodule included
      git -c url.https://github.com/.insteadOf=git@github.com: \
        -c "http.https://github.com/.extraheader=AUTHORIZATION: basic $(printf 'x-access-token:%s' "${TOKEN}" | base64 | tr -d '\n')" \
        "${clone[@]}"
    else
      git "${clone[@]}"
    fi
  fi
  if [ -e "${PUBLIC_DOCS_DIR}/kms" ] && [ ! -L "${PUBLIC_DOCS_DIR}/kms" ]; then
    print_error "${PUBLIC_DOCS_DIR}/kms exists and is not a symlink"
  fi
  ln -sfn "${REPO_ROOT}" "${PUBLIC_DOCS_DIR}/kms"

  cd "${PUBLIC_DOCS_DIR}"
  bash .github/scripts/build-staging.sh kms

  print_success "Combined documentation built → ${PUBLIC_DOCS_DIR}/book/"
fi
