#!/usr/bin/env bash
#MISE description="Build the KMS documentation site with mdBook"
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

print_header "Building KMS documentation"

REPO_ROOT="$(get_repo_root)"

# Keep these versions synchronized with documentation/theme/scripts/setup-mdbook.sh:6-8.
if [[ "$(mdbook --version 2>/dev/null || true)" != "mdbook v0.4.52" ]] ||
  [[ "$(mdbook-admonish --version 2>/dev/null || true)" != "mdbook-admonish 1.20.0" ]] ||
  [[ "$(mdbook-mermaid --version 2>/dev/null || true)" != "mdbook-mermaid 0.16.0" ]]; then
  # The theme script bootstraps rustup with `curl | sh` when cargo is missing: never reach it from here.
  command -v cargo >/dev/null 2>&1 ||
    print_error "mdBook toolchain missing or outdated and cargo is not on PATH: install Rust (https://rustup.rs) or the pinned mdbook, mdbook-admonish and mdbook-mermaid versions"
  print_info "Installing pinned mdBook toolchain..."
  bash "${REPO_ROOT}/documentation/theme/scripts/setup-mdbook.sh"
fi

cd "${REPO_ROOT}/documentation"
mdbook build

print_success "Documentation built → documentation/book/html/"
