#!/usr/bin/env bash
#MISE description="Run IBM Db2 LUW KMIP TDE integration tests"
#MISE depends=["build:kms"]
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging
ensure_nix_shell

print_header "Running IBM Db2 LUW KMIP TDE integration tests (${VARIANT_NAME})"

require_cmd docker "Docker is required to run the Db2 container."

bash "${MISE_CONFIG_ROOT}/.mise/scripts/test/test_db2_tde.sh" --variant "$VARIANT" --link "$LINK"

print_success "Db2 TDE tests completed"
