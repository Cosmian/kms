#!/usr/bin/env bash
#MISE description="SCEP (RFC 8894) interoperability test against the micromdm scepclient and an Apple SCEP profile"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }

# Black-box test: starts a live KMS server with SCEP enabled and drives it with the
# third-party `scepclient` (github.com/micromdm/scep, as used by MicroMDM / Smallstep and
# Apple-MDM deployments): PKCSReq with challenge, challenge-less RenewalReq, wrong challenge.
# On macOS it also validates an Apple `com.apple.security.scep` configuration profile and
# enrolls with the parameters taken from it.
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
kms_init_env "${usage_variant:-fips}" "${usage_link:-static}"
setup_test_logging

REPO_ROOT="$(get_repo_root)"
bash "${REPO_ROOT}/.mise/scripts/test/test_scep_interop.sh" \
  --variant "${usage_variant:-fips}" --link "${usage_link:-static}"

print_success "SCEP interoperability tests completed"
