#!/usr/bin/env bash
#MISE description="Run CEF-over-UDP-syslog integration test"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="Feature variant (must be non-fips)" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
# Proves ADR-005 CEF format via UDP syslog transport.
# Requires non-fips: CEF export is only available in non-fips builds.
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

VARIANT="${usage_variant:-non-fips}"
if [[ "${VARIANT}" == "fips" ]]; then
  echo "ERROR: CEF syslog test requires --variant non-fips." >&2
  exit 1
fi

kms_init_env "${VARIANT}" "static"
setup_test_logging

print_header "Running CEF-over-UDP-syslog integration test (${VARIANT_NAME})"

REPO_ROOT="$(get_repo_root)"
bash "${REPO_ROOT}/.mise/scripts/test/test_siem_cef_syslog.sh" --variant "${VARIANT}"

print_success "CEF-over-UDP-syslog test completed"
