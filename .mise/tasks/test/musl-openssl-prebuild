#!/usr/bin/env bash
#MISE description="Build a minimal OpenSSL for the musl cross-check (test:musl-crosscheck prerequisite)"
#USAGE flag "-o --out-dir <out_dir>" env="OUT_DIR" help="Install prefix" default="/tmp/musl-openssl-crosscheck"
set -euo pipefail
# shellcheck source=.mise/lib/common.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

# ---------------------------------------------------------------------------
# `test:musl-crosscheck` needs a working OPENSSL_DIR before Cargo can even
# resolve the dependency graph (the standalone `openssl`/`openssl-sys` crate —
# used directly by cosmian_kms_crypto, cosmian_kms_server, etc. — needs it
# independently of crate/crypto/build.rs, which only builds OpenSSL for its
# own crate's linking needs). This script builds a small, non-FIPS OpenSSL
# from the same source tarball/hash crate/crypto/build.rs uses, with
# `musl-gcc` as the compiler, for use ONLY as OPENSSL_DIR in the cross-check —
# it is not FIPS-validated and must never be shipped or used for anything
# other than this CI cross-check build.
# ---------------------------------------------------------------------------

OPENSSL_VERSION="3.6.2"
OPENSSL_URL="https://package.cosmian.com/openssl/openssl-${OPENSSL_VERSION}.tar.gz"
OPENSSL_SHA256="aaf51a1fe064384f811daeaeb4ec4dce7340ec8bd893027eee676af31e83a04f"

require_cmd curl
require_cmd perl
require_cmd make
require_cmd musl-gcc "musl-gcc not found — install musl-tools first (apt-get install -y musl-tools)."

case "$(uname -m)" in
  x86_64) OPENSSL_TARGET="linux-x86_64" ;;
  aarch64 | arm64) OPENSSL_TARGET="linux-aarch64" ;;
  *) print_error "Unsupported architecture: $(uname -m)" ;;
esac

OUT_DIR="${usage_out_dir:-/tmp/musl-openssl-crosscheck}"
WORK_DIR="$(mktemp -d)"
trap 'rm -rf "${WORK_DIR}"' EXIT

print_header "Building OpenSSL ${OPENSSL_VERSION} (musl-gcc, ${OPENSSL_TARGET}) for the cross-check"

if [ -f "${OUT_DIR}/lib/libcrypto.a" ]; then
  print_status "Reusing existing build at ${OUT_DIR}"
  print_success "Musl OpenSSL ready at ${OUT_DIR}"
  exit 0
fi

TARBALL="${WORK_DIR}/openssl-${OPENSSL_VERSION}.tar.gz"
curl -fsSL "${OPENSSL_URL}" -o "${TARBALL}"
ACTUAL_SHA256="$(sha256sum "${TARBALL}" | awk '{print $1}')"
[ "${ACTUAL_SHA256}" = "${OPENSSL_SHA256}" ] || print_error "OpenSSL tarball hash mismatch: expected ${OPENSSL_SHA256}, got ${ACTUAL_SHA256}"

tar -C "${WORK_DIR}" -xf "${TARBALL}"
SRC_DIR="${WORK_DIR}/openssl-${OPENSSL_VERSION}"
mkdir -p "${OUT_DIR}"

(
  cd "${SRC_DIR}"
  # musl-gcc's specs file replaces the default include search path with
  # musl's own sysroot (/usr/include/<arch>-linux-musl), which does not
  # contain the Linux kernel UAPI headers (linux/mman.h etc. — provided by
  # the `linux-libc-dev` package at the generic /usr/include/linux/ path).
  # OpenSSL's crypto/mem_sec.c needs these. Copy just that one subtree into
  # musl's sysroot rather than adding -I/usr/include wholesale, which would
  # also pull in glibc's own (incompatible) libc headers ahead of musl's.
  MUSL_INCLUDE_DIR="/usr/include/$(uname -m)-linux-musl"
  GNU_INCLUDE_DIR="/usr/include/$(uname -m)-linux-gnu"
  if [ -d "${MUSL_INCLUDE_DIR}" ] && [ ! -e "${MUSL_INCLUDE_DIR}/linux" ]; then
    cp -r /usr/include/linux "${MUSL_INCLUDE_DIR}/linux"
    cp -r /usr/include/asm-generic "${MUSL_INCLUDE_DIR}/asm-generic" 2>/dev/null || true
    # linux/mman.h etc. further include the arch-specific "asm/..." headers
    # (e.g. asm/mman.h), which on Debian/Ubuntu live under the glibc
    # multiarch directory, not /usr/include directly.
    [ -d "${GNU_INCLUDE_DIR}/asm" ] && cp -r "${GNU_INCLUDE_DIR}/asm" "${MUSL_INCLUDE_DIR}/asm"
  fi
  CC=musl-gcc perl ./Configure no-shared no-fips \
    --prefix="${OUT_DIR}" --openssldir="${OUT_DIR}/ssl" --libdir=lib "${OPENSSL_TARGET}"
  make -j"$(nproc)" depend
  make -j"$(nproc)"
  make install_sw
)

print_success "Musl OpenSSL ready at ${OUT_DIR}"
