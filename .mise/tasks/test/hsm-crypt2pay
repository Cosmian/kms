#!/usr/bin/env bash
#MISE description="Run Crypt2Pay HSM tests (Linux only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#USAGE flag "-d --db <db>" env="DB" help="DB backend (accepted for matrix consistency; loader tests do not use a KMS server DB)" default="sqlite" {
#USAGE   choices "sqlite" "postgresql" "mysql" "percona" "maria" "redis"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
kms_init_env "${usage_variant:-fips}" "${usage_link:-static}"
setup_test_logging
export WITH_HSM=1
ensure_nix_shell

cleanup() {
  if [[ -f /tmp/crypt2pay-openvpn.pid ]]; then
    sudo kill "$(cat /tmp/crypt2pay-openvpn.pid)" 2>/dev/null || true
    sudo rm -f /tmp/crypt2pay-openvpn.pid
  fi
  if [[ -f /tmp/crypt2pay-openvpn.conf ]]; then
    sudo rm -f /tmp/crypt2pay-openvpn.conf
  fi
}

trap cleanup EXIT

print_header "Running Crypt2Pay HSM tests (${VARIANT_NAME})"

# Prepare Crypt2Pay HSM libraries: downloads, extracts, and installs to /lib/.
bash "${MISE_CONFIG_ROOT}/.github/reusable_scripts/prepare_crypt2pay.sh"

require_cmd cargo

# CRYPT2PAY_PKCS11_LIB matches the crate constant in crypt2pay_pkcs11_loader.
# HSM_USER_PASSWORD is read by the Rust test harness.
# C2P_CONF must point to c2p.xml so the C2P library can find its hardware config.
CRYPT2PAY_PKCS11_LIB=/lib/libpkcs11c2p.so \
  C2P_CONF=/etc/c2p/c2p.xml \
  HSM_USER_PASSWORD="${CRYPT2PAY_PASSWORD}" \
  cargo test \
  -p crypt2pay_pkcs11_loader \
  --features crypt2pay \
  -- --nocapture tests::test_hsm_crypt2pay_all --ignored --exact

print_success "Crypt2Pay HSM tests completed"
