#!/usr/bin/env bash
#MISE description="EST (RFC 7030) interoperability test against the globalsign estclient over TLS / mTLS"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#SUITE variants=fips,non-fips needs=nix

# Black-box test: starts a live KMS server over TLS with EST enabled and drives it with a
# third-party EST client: /cacerts, /csrattrs, /simpleenroll (HTTP Basic bootstrap),
# /simplereenroll (mutual TLS with the certificate being renewed).
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/suites.sh"
suite_init fips

# The estclient is built with Go: use the Nix shell's Go unless one is already on PATH
# (the macOS CI job installs it with actions/setup-go and has no Nix).
if ! has_cmd go; then
  export WITH_GO=1
  # shellcheck disable=SC2119  # ensure_nix_shell intentionally called without args here
  ensure_nix_shell
fi

bash "${REPO_ROOT}/.mise/scripts/test/test_est_interop.sh" \
  --variant "${usage_variant:-fips}" --link "${usage_link:-static}"

print_success "EST interoperability tests completed"
