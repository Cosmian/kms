#!/usr/bin/env bash
#MISE description="Run SAP ASE KMIP TDE integration test (local dev only, requires manually built cosmian-ase-kmip image)"
#MISE depends=["build:kms"]
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging
ensure_nix_shell

print_header "Running SAP ASE KMIP TDE integration test (${VARIANT_NAME})"

require_cmd docker "Docker is required to run the ASE container."

bash "${MISE_CONFIG_ROOT}/.mise/scripts/test/test_ase_tde.sh" --variant "$VARIANT" --link "$LINK"

print_success "ASE TDE test completed"
