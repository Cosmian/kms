#!/usr/bin/env bash
#MISE description="Run GnuPG OpenPGP interoperability tests against KMS PGP keys (non-FIPS only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging

if [ "$VARIANT" != "non-fips" ]; then
  print_error "GnuPG tests require non-fips variant (OpenPGP is gated behind the non-fips feature) (got: $VARIANT)"
fi

require_cmd gpg "GnuPG is required for the OpenPGP interoperability tests. Install gnupg and re-run."

print_header "Running GnuPG OpenPGP interoperability tests"

REPO_ROOT="$(get_repo_root)"
bash "${REPO_ROOT}/.mise/scripts/test/test_gnupg.sh" --variant "$VARIANT" --link "$LINK"

print_success "GnuPG OpenPGP interoperability tests completed"
