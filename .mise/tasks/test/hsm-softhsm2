#!/usr/bin/env bash
#MISE description="Run SoftHSM2 HSM tests"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#USAGE flag "-d --db <db>" env="DB" help="DB backend to test against" default="sqlite" {
#USAGE   choices "sqlite" "postgresql" "mysql" "percona" "maria" "redis"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/softhsm2.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
kms_init_env "${usage_variant:-fips}" "${usage_link:-static}"
setup_db_env "${usage_db:-sqlite}"
setup_test_logging
export WITH_HSM=1
# shellcheck disable=SC2119  # ensure_nix_shell intentionally called without args here
ensure_nix_shell

print_header "Running SoftHSM2 HSM tests (${VARIANT_NAME})"

REPO_ROOT="$(get_repo_root)"

# ── SoftHSM2 setup ──────────────────────────────────────────────────────────
softhsm2_setup "${REPO_ROOT}/.softhsm2/tokens" "${REPO_ROOT}/.softhsm2/softhsm2.conf"
softhsm2_init_standard_tokens "my_token"

export HSM_USER_PASSWORD
export SOFTHSM2_PKCS11_LIB="${SOFTHSM2_PKCS11_LIB_PATH:-}"
export HSM_MODEL="softhsm2"
export HSM_SLOT_ID="$SOFTHSM2_HSM_SLOT_ID"

LIB_PATH="$(softhsm2_lib_search_path)"

# ── Run KMS server HSM tests ────────────────────────────────────────────────
env \
  PATH="$PATH" \
  LD_LIBRARY_PATH="$LIB_PATH" \
  DYLD_LIBRARY_PATH="$LIB_PATH" \
  SOFTHSM2_CONF="$SOFTHSM2_CONF" \
  SOFTHSM2_PKCS11_LIB="${SOFTHSM2_PKCS11_LIB_PATH:-}" \
  HSM_MODEL="softhsm2" \
  HSM_USER_PASSWORD="$HSM_USER_PASSWORD" \
  HSM_SLOT_ID="$SOFTHSM2_HSM_SLOT_ID" \
  KMS_TEST_DB="${KMS_TEST_DB:-sqlite}" \
  ${KMS_POSTGRES_URL:+KMS_POSTGRES_URL="$KMS_POSTGRES_URL"} \
  ${KMS_MYSQL_URL:+KMS_MYSQL_URL="$KMS_MYSQL_URL"} \
  ${REDIS_HOST:+REDIS_HOST="$REDIS_HOST"} \
  ${REDIS_PORT:+REDIS_PORT="$REDIS_PORT"} \
  cargo test \
  -p cosmian_kms_server \
  ${FEATURES_FLAG[@]+"${FEATURES_FLAG[@]}"} \
  -- tests::hsm::test_hsm_all --ignored --exact

print_status "SoftHSM2 KMS server tests completed"

# ── Run test_kms_server HSM vector tests ─────────────────────────────────────
print_header "Running test_kms_server HSM vector tests"
env \
  PATH="$PATH" \
  LD_LIBRARY_PATH="$LIB_PATH" \
  DYLD_LIBRARY_PATH="$LIB_PATH" \
  SOFTHSM2_CONF="$SOFTHSM2_CONF" \
  SOFTHSM2_PKCS11_LIB="${SOFTHSM2_PKCS11_LIB_PATH:-}" \
  HSM_MODEL="softhsm2" \
  HSM_USER_PASSWORD="$HSM_USER_PASSWORD" \
  HSM_SLOT_ID="$SOFTHSM2_HSM_SLOT_ID" \
  KMS_TEST_DB="${KMS_TEST_DB:-sqlite}" \
  ${KMS_POSTGRES_URL:+KMS_POSTGRES_URL="$KMS_POSTGRES_URL"} \
  ${KMS_MYSQL_URL:+KMS_MYSQL_URL="$KMS_MYSQL_URL"} \
  ${REDIS_HOST:+REDIS_HOST="$REDIS_HOST"} \
  ${REDIS_PORT:+REDIS_PORT="$REDIS_PORT"} \
  cargo test \
  -p test_kms_server \
  ${FEATURES_FLAG[@]+"${FEATURES_FLAG[@]}"} \
  --lib \
  -- test_vec_hsm

print_status "HSM vector tests completed"

# ── Run cosmian_pkcs11 HSM-KEK conformance tests ────────────────────────────
# Mandatory PKCS#11 signing tests (EdDSA Ed25519, ECDSA P-256, ECDSA
# secp256k1), an RSA-PSS sign test, and an end-to-end C_Verify round-trip
# test (including a tampered-signature negative case), all against a KMS
# server backed by SoftHSM2 with a Key-Encryption-Key (HSM-KEK). These tests
# live in `cosmian_pkcs11`'s non-fips-only `tests_v3` module (PKCS#11 v3.x
# conformance tests are never mixed with the legacy `tests` module), so they
# only run for the non-fips variant.
if [ "${VARIANT:-}" = "non-fips" ]; then
  print_header "Running cosmian_pkcs11 HSM-KEK conformance tests"
  env \
    PATH="$PATH" \
    LD_LIBRARY_PATH="$LIB_PATH" \
    DYLD_LIBRARY_PATH="$LIB_PATH" \
    SOFTHSM2_CONF="$SOFTHSM2_CONF" \
    SOFTHSM2_PKCS11_LIB="${SOFTHSM2_PKCS11_LIB_PATH:-}" \
    HSM_MODEL="softhsm2" \
    HSM_USER_PASSWORD="$HSM_USER_PASSWORD" \
    HSM_SLOT_ID="$SOFTHSM2_HSM_SLOT_ID" \
    KMS_TEST_DB="${KMS_TEST_DB:-sqlite}" \
    ${KMS_POSTGRES_URL:+KMS_POSTGRES_URL="$KMS_POSTGRES_URL"} \
    ${KMS_MYSQL_URL:+KMS_MYSQL_URL="$KMS_MYSQL_URL"} \
    ${REDIS_HOST:+REDIS_HOST="$REDIS_HOST"} \
    ${REDIS_PORT:+REDIS_PORT="$REDIS_PORT"} \
    cargo test \
    -p cosmian_pkcs11 \
    ${FEATURES_FLAG[@]+"${FEATURES_FLAG[@]}"} \
    --lib \
    -- --ignored test_hsm_kek --test-threads=1

  print_status "cosmian_pkcs11 HSM-KEK conformance tests completed"
else
  print_status "Skipping cosmian_pkcs11 HSM-KEK conformance tests (non-fips only)"
fi

# ── Run softhsm2 loader tests ───────────────────────────────────────────────
# Note: softhsm2_pkcs11_loader has no feature flags — never pass --features here
print_header "Running softhsm2_pkcs11_loader tests"
env \
  PATH="$PATH" \
  LD_LIBRARY_PATH="$LIB_PATH" \
  DYLD_LIBRARY_PATH="$LIB_PATH" \
  SOFTHSM2_CONF="$SOFTHSM2_CONF" \
  SOFTHSM2_PKCS11_LIB="${SOFTHSM2_PKCS11_LIB_PATH:-}" \
  HSM_USER_PASSWORD="$HSM_USER_PASSWORD" \
  HSM_SLOT_ID="$SOFTHSM2_HSM_SLOT_ID" \
  cargo test \
  -p softhsm2_pkcs11_loader \
  --features softhsm2 \
  -- --nocapture tests::test_hsm_softhsm2_all --ignored --exact

print_success "SoftHSM2 tests completed"
