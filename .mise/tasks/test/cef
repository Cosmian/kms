#!/usr/bin/env bash
#MISE description="Run all CEF integration tests (format, UDP syslog, TCP rsyslog)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="Feature variant (must be non-fips)" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "--suite <suite>" env="SUITE" help="Which CEF sub-test to run" default="all" {
#USAGE   choices "all" "format" "syslog" "tcp-syslog"
#USAGE }
# Proves CEF v27 format compliance + TCP syslog transport.
# Requires non-fips: CEF export is only available in non-fips builds.
# No Nix shell needed. Uses Docker for syslog receivers and Cargo for KMS.
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

VARIANT="${usage_variant:-non-fips}"
if [[ "${VARIANT}" == "fips" ]]; then
  echo "ERROR: CEF integration tests require --variant non-fips." >&2
  echo "       CEF export is only available in non-fips builds." >&2
  exit 1
fi

kms_init_env "${VARIANT}" "static"
setup_test_logging

SUITE="${SUITE:-all}"
REPO_ROOT="$(get_repo_root)"

run_sub() {
  local name="$1"
  local script="$2"
  print_header "CEF sub-test: ${name}"
  bash "${REPO_ROOT}/.mise/scripts/test/${script}" --variant "${VARIANT}"
  print_success "CEF sub-test passed: ${name}"
}

print_header "Running CEF integration tests — suite='${SUITE}' (${VARIANT_NAME})"
echo "Purpose: prove CEF v27 format compliance + TCP syslog transport"
echo ""

case "${SUITE}" in
  all)
    run_sub "CEF format validation" "test_cef_format.sh"
    run_sub "CEF-over-UDP-syslog" "test_siem_cef_syslog.sh"
    run_sub "CEF-over-TCP-syslog (rsyslog)" "test_siem_cef_tcp_syslog.sh"
    ;;
  format)
    run_sub "CEF format validation" "test_cef_format.sh"
    ;;
  syslog)
    run_sub "CEF-over-UDP-syslog" "test_siem_cef_syslog.sh"
    ;;
  tcp-syslog)
    run_sub "CEF-over-TCP-syslog (rsyslog)" "test_siem_cef_tcp_syslog.sh"
    ;;
  *)
    print_error "Unknown suite '${SUITE}'. Valid: all, format, syslog, tcp-syslog"
    exit 1
    ;;
esac

print_success "All CEF integration tests passed (suite=${SUITE}, variant=${VARIANT})"
