#!/usr/bin/env bash
#MISE description="Run OTLP audit log export integration test (ADR-006)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="Feature variant (must be non-fips)" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
# Proves ADR-006 (AuditOtlpLogs → OTel collector, cef_line attribute).
# Requires non-fips: audit OTLP export is only available in non-fips builds.
# Requires Docker: otel/opentelemetry-collector-contrib.
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

VARIANT="${usage_variant:-non-fips}"
if [[ "${VARIANT}" == "fips" ]]; then
  echo "ERROR: OTLP audit export test requires --variant non-fips." >&2
  echo "       AuditOtlpLogs is only available in non-fips builds." >&2
  exit 1
fi

kms_init_env "${VARIANT}" "static"
setup_test_logging

print_header "Running OTLP audit log export integration test (${VARIANT_NAME})"
echo "Purpose: prove ADR-006 (AuditOtlpLogs → OTel collector pipeline)"

REPO_ROOT="$(get_repo_root)"
bash "${REPO_ROOT}/.mise/scripts/test/test_otlp_audit.sh" --variant "${VARIANT}"

print_success "OTLP audit log export test completed"
