#!/usr/bin/env bash
#MISE description="Run audit log integration test (JSONL, hash chain, fields)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="Feature variant (must be non-fips)" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
# Proves tamper-evident JSONL single-writer log + HTTP audit middleware capture.
# Requires non-fips: audit middleware and CEF features are only in non-fips builds.
# No Nix shell needed. Uses Cargo to build KMS binary.
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

VARIANT="${usage_variant:-non-fips}"
if [[ "${VARIANT}" == "fips" ]]; then
  echo "ERROR: Audit integration test requires --variant non-fips." >&2
  echo "       Audit middleware features are only available in non-fips builds." >&2
  exit 1
fi

kms_init_env "${VARIANT}" "static"
setup_test_logging

print_header "Running audit log integration test (${VARIANT_NAME})"
echo "Purpose: prove tamper-evident JSONL hash chain + HTTP audit middleware capture"

REPO_ROOT="$(get_repo_root)"
bash "${REPO_ROOT}/.mise/scripts/test/test_audit_log.sh" --variant "${VARIANT}"

print_success "Audit log integration test completed"
