#!/usr/bin/env bash
#MISE description="Run JOSE REST API + jwcrypto interoperability tests"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/kms_server.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging
ensure_nix_shell

print_header "Running JOSE REST API tests (${VARIANT_NAME})"

REPO_ROOT="$(get_repo_root)"

# Delegate to the existing JOSE test script which handles both phases
bash "${REPO_ROOT}/.mise/scripts/test/test_jose.sh" --variant "$VARIANT" --link "$LINK"

print_success "JOSE tests completed"
