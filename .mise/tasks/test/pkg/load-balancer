#!/usr/bin/env bash
#MISE description="Run nginx load-balancer graceful shutdown test"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
kms_init_env "${usage_variant:-fips}" "${usage_link:-static}"
setup_test_logging
REPO_ROOT="$(get_repo_root "${MISE_CONFIG_ROOT}")"
has_env_vars DOCKER_IMAGE_NAME || skip_test "env DOCKER_IMAGE_NAME not set"
if [ "${CI:-}" != true ]; then
  has_cmd nix-shell || skip_test "nix-shell not found"
  docker_ready || skip_test "Docker is not running"
fi
ensure_nix_shell

print_header "Running load-balancer shutdown test (${VARIANT_NAME})"

bash "${REPO_ROOT}/.mise/scripts/test/test_lb_kms_shutdown.sh" --variant "$VARIANT" --link "$LINK"

print_success "Load-balancer tests completed"
