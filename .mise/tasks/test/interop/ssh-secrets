#!/usr/bin/env bash
#MISE description="SSH certificates accepted/rejected by a real sshd, and database password rotation (PostgreSQL, MySQL) published to the KV store"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
kms_init_env "${usage_variant:-fips}" "${usage_link:-static}"
setup_test_logging
REPO_ROOT="$(get_repo_root)"
# Every scenario runs even if an earlier one fails, so one run reports every failure. The rotation
# scenario is engine-independent on the KMS side: it runs once per supported database engine.
failed=0
run_scenario() { # <script> [args...]
  local script="$1"
  shift
  print_header "${script} $*"
  bash "${REPO_ROOT}/.mise/scripts/test/${script}" --variant "$VARIANT" --link "$LINK" "$@" || failed=1
}
run_scenario test_ssh_certificates.sh
for engine in postgres mysql; do
  run_scenario test_secret_rotation.sh --db "${engine}"
done
[[ "${failed}" -eq 0 ]] || print_error "SSH certificates or secret rotation scenario failed"
