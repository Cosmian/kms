#!/usr/bin/env bash
#MISE description="SOPS Vault Transit and OpenPGP interoperability tests (non-FIPS)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail

source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging

[ "${VARIANT}" = non-fips ] || skip_test "SOPS OpenPGP integration requires the non-fips variant"
if [ "$(uname)" != Linux ]; then
  skip_test "SOPS PKCS#11-backed OpenPGP integration requires the Linux gnupg-pkcs11-scd package"
fi
if [ "${CI:-}" != true ]; then
  has_cmd nix-shell || skip_test "nix-shell not found"
fi

export WITH_SOPS=1 WITH_HSM=1 WITH_GNUPG_PKCS11=1
ensure_nix_shell

REPO_ROOT="$(get_repo_root)"
bash "${REPO_ROOT}/.mise/scripts/test/interop/sops.sh" --variant "${VARIANT}" --link "${LINK}"
