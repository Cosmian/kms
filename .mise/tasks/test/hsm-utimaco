#!/usr/bin/env bash
#MISE description="Run Utimaco HSM simulator tests (Linux only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#USAGE flag "-d --db <db>" env="DB" help="DB backend (accepted for matrix consistency; loader tests do not use a KMS server DB)" default="sqlite" {
#USAGE   choices "sqlite" "postgresql" "mysql" "percona" "maria" "redis"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
kms_init_env "${usage_variant:-fips}" "${usage_link:-static}"
setup_test_logging

if [ "$(uname)" != "Linux" ]; then
  print_error "Utimaco tests require Linux"
fi

ensure_nix_shell

print_header "Running Utimaco HSM tests (${VARIANT_NAME})"

# shellcheck disable=SC2034  # REPO_ROOT reserved for future path references
REPO_ROOT="$(get_repo_root)"

# Prepare Utimaco simulator (extracted by reusable_scripts/prepare_utimaco.sh)
require_cmd cargo

# Note: tests are gated behind --features utimaco (mod tests is #[cfg(feature = "utimaco")])
cargo test \
  -p utimaco_pkcs11_loader \
  --features utimaco \
  -- --nocapture test_hsm_utimaco_all --ignored --exact

print_success "Utimaco HSM tests completed"
