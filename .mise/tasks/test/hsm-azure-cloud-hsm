#!/usr/bin/env bash
#MISE description="Run Azure Cloud HSM PKCS#11 tests (Linux only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
set -euo pipefail
# shellcheck disable=SC1091
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
kms_init_env "${usage_variant:-fips}" "static"
setup_test_logging

if [[ "$(uname -s)" != "Linux" ]]; then
  print_error "Azure Cloud HSM tests require Linux"
fi

require_cmd cargo
: "${HSM_USER_PASSWORD:?Set HSM_USER_PASSWORD to the Cloud HSM user:password PIN}"

# Installs the Azure Cloud HSM SDK, writes PO.crt and azcloudhsm_resource.cfg, opens a
# VPN tunnel to the private endpoint if needed, and starts the azcloudhsm_client daemon.
# See crate/hsm/azure_cloud_hsm/README.md for the one-time partition/CU provisioning steps.
# shellcheck disable=SC1091
source "${MISE_CONFIG_ROOT}/.github/reusable_scripts/prepare_azure_cloudhsm.sh"

print_header "Running Azure Cloud HSM tests (${VARIANT_NAME})"

cargo test -p azure_cloud_hsm_pkcs11_loader \
  --features azure_cloud_hsm \
  -- --nocapture tests::test_hsm_azure_cloud_hsm_all --ignored --exact

print_success "Azure Cloud HSM tests completed"
