#!/usr/bin/env bash
#MISE description="Run GCP Cloud HSM PKCS#11 tests (Linux only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
kms_init_env "${usage_variant:-fips}" "${usage_link:-static}"
setup_test_logging

if [[ "$(uname -s)" != "Linux" ]]; then
  print_error "GCP Cloud HSM tests require Linux"
fi

require_cmd cargo
: "${GCP_CLOUD_HSM_PKCS11_LIB:?Set GCP_CLOUD_HSM_PKCS11_LIB to the Google libkmsp11.so}"
: "${HSM_USER_PASSWORD:?Set HSM_USER_PASSWORD to the PKCS#11 PIN}"

print_header "Running GCP Cloud HSM tests (${VARIANT_NAME})"

GCP_CLOUD_HSM_PKCS11_LIB="$GCP_CLOUD_HSM_PKCS11_LIB" \
  HSM_USER_PASSWORD="$HSM_USER_PASSWORD" \
  HSM_SLOT_ID="${HSM_SLOT_ID:-0}" \
  cargo test -p gcp_cloud_hsm_pkcs11_loader \
  --features gcp_cloud_hsm \
  -- --nocapture tests::test_hsm_gcp_cloud_hsm_all --ignored --exact

print_success "GCP Cloud HSM tests completed"
