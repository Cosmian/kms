#!/usr/bin/env bash
#MISE description="SPIRE kmip KeyManager plugin e2e (non-FIPS only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }

# End-to-end test for the SPIRE `kmip` built-in KeyManager plugin speaking
# KMIP 1.4 binary TTLV over TCP/TLS to a locally-built KMS.
#
# Entry point used by `test:spire`; delegates to test:spire-kmip-key-manager.
#
# The SPIRE plugin uses ovh/kmip-go (binary TTLV/TCP) — NOT the Cosmian HTTPS client.

set -euo pipefail

source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

VARIANT="${usage_variant:-non-fips}"
LINK="${usage_link:-static}"

if [ "${VARIANT}" != "non-fips" ]; then
  print_error "spire-kmip tests require non-fips variant (got: ${VARIANT})"
fi

print_header "SPIRE kmip plugin E2E — KeyManager"

mise run test:spire-kmip-key-manager --variant "${VARIANT}" --link "${LINK}"

print_success "All SPIRE kmip plugin tests passed"
