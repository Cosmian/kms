#!/usr/bin/env bash
#MISE description="Run Proteccio HSM tests (Linux only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#USAGE flag "-d --db <db>" env="DB" help="DB backend (accepted for matrix consistency; loader tests do not use a KMS server DB)" default="sqlite" {
#USAGE   choices "sqlite" "postgresql" "mysql" "percona" "maria" "redis"
#USAGE }
# Keep HSM PINs out of inherited shell tracing.
set +x
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
kms_init_env "${usage_variant:-fips}" "${usage_link:-static}"
setup_test_logging
# shellcheck disable=SC2119  # ensure_nix_shell intentionally called without args here
ensure_nix_shell

print_header "Running Proteccio HSM tests (${VARIANT_NAME})"

# Prepare Proteccio HSM libraries: downloads, extracts, and installs to /lib/.
bash "${MISE_CONFIG_ROOT}/.github/reusable_scripts/prepare_proteccio.sh"

require_cmd cargo

# PROTECCIO_PKCS11_LIB matches the crate constant in proteccio_pkcs11_loader.
# HSM_USER_PASSWORD and HSM_SLOT_ID are read by the Rust test harness.
# The vendor library (libnethsm.so) fails in C_Initialize (CKR_FUNCTION_FAILED) when the
# nix-shell FIPS OpenSSL bootstrap variables are inherited, so run the test with a clean
# OpenSSL environment (same as the nethsmstatus check in prepare_proteccio.sh).
env -u LD_PRELOAD -u LD_LIBRARY_PATH -u OPENSSL_CONF -u OPENSSL_MODULES \
  PROTECCIO_PKCS11_LIB=/lib/libnethsm.so \
  HSM_USER_PASSWORD="${PROTECCIO_PASSWORD}" \
  HSM_SLOT_ID="${PROTECCIO_SLOT}" \
  cargo test \
  -p proteccio_pkcs11_loader \
  --features proteccio \
  ${FEATURES_FLAG[@]+"${FEATURES_FLAG[@]}"} \
  -- --nocapture tests::test_hsm_proteccio_all --ignored --exact

# Proteccio's embedded OpenSSL rejects the Nix FIPS config from OPENSSL_CONF. Run the KMS
# startup test in the official FIPS image so it uses the image's built-in config path.
if [ "${VARIANT}" = "fips" ]; then
  require_cmd docker
  require_cmd jq
  # shellcheck source=.mise/lib/kms_build.sh
  source "${MISE_CONFIG_ROOT}/.mise/lib/kms_build.sh"

  build_log="$(mktemp)"
  trap 'rm -f -- "${build_log:?}"' EXIT
  if ! cargo test -p test_kms_server \
    ${FEATURES_FLAG[@]+"${FEATURES_FLAG[@]}"} \
    --lib --no-run --message-format=json >"${build_log}"; then
    cat "${build_log}" >&2
    exit 1
  fi

  test_binary="$(jq -er 'select(.reason == "compiler-artifact" and .target.name == "test_kms_server" and .profile.test == true and .executable != null) | .executable' "${build_log}")"
  package_id="$(cargo pkgid -p cosmian_kms_server)"
  image_version="${package_id##*@}"
  target_dir="$(cd "$(get_cargo_target_dir)" && pwd)"

  docker run --rm --network host \
    --volume /nix/store:/nix/store:ro \
    --volume "${MISE_CONFIG_ROOT}:${MISE_CONFIG_ROOT}:ro" \
    --volume "${target_dir}:${target_dir}:ro" \
    --volume /etc/proteccio:/etc/proteccio:ro \
    --volume /lib/libnethsm.so:/lib/libnethsm.so:ro \
    --env PROTECCIO_PKCS11_LIB=/lib/libnethsm.so \
    --env HSM_MODEL=proteccio \
    --env HSM_USER_PASSWORD="${PROTECCIO_PASSWORD:?PROTECCIO_PASSWORD must be set}" \
    --env HSM_SLOT_ID="${PROTECCIO_SLOT:?PROTECCIO_SLOT must be set}" \
    --entrypoint env \
    "ghcr.io/cosmian/kms-fips:${image_version}" \
    -u OPENSSL_CONF -u LD_PRELOAD -u LD_LIBRARY_PATH \
    "${test_binary}" --ignored --exact hsm_startup_tests::test_startup_with_hsm_kek_proteccio
else
  env -u LD_PRELOAD -u LD_LIBRARY_PATH \
    PROTECCIO_PKCS11_LIB=/lib/libnethsm.so \
    HSM_MODEL=proteccio \
    HSM_USER_PASSWORD="${PROTECCIO_PASSWORD:?PROTECCIO_PASSWORD must be set}" \
    HSM_SLOT_ID="${PROTECCIO_SLOT:?PROTECCIO_SLOT must be set}" \
    cargo test \
    -p test_kms_server \
    ${FEATURES_FLAG[@]+"${FEATURES_FLAG[@]}"} \
    --lib \
    -- --ignored --exact hsm_startup_tests::test_startup_with_hsm_kek_proteccio
fi

print_success "Proteccio HSM tests completed"
