#!/usr/bin/env bash
#MISE description="Run MariaDB tests"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/softhsm2.sh"
kms_init_env "${usage_variant:-fips}" "${usage_link:-static}"
setup_test_logging
REPO_ROOT="$(get_repo_root "${MISE_CONFIG_ROOT}")"
if [ "${CI:-}" != true ]; then
  has_cmd nix-shell || skip_test "nix-shell not found"
fi
export WITH_HSM=1
ensure_nix_shell
docker compose -f "${REPO_ROOT}/docker-compose.yml" up -d mariadb || {
  if [ "${CI:-}" = true ]; then print_error "could not start compose: mariadb"; fi
  skip_test "could not start compose: mariadb"
}

print_header "Running MariaDB tests (${VARIANT_NAME})"

# CI sets KMS_MARIADB_URL; fall back to slot-aware port default
export KMS_MYSQL_URL="${KMS_MARIADB_URL:-${KMS_MYSQL_URL:-mysql://kms:kms@127.0.0.1:${KMS_SLOT_MARIADB_PORT:-3308}/kms}}"
# Probe the MariaDB port, not check_and_test_db's MySQL default (3306).
: "${MARIADB_PORT:=${KMS_SLOT_MARIADB_PORT:-3308}}"

check_and_test_db "MariaDB" "mysql" "MARIADB_HOST" "MARIADB_PORT"
run_db_softhsm2_tests "mysql_softhsm2"

print_success "MariaDB tests completed"
