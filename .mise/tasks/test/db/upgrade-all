#!/usr/bin/env bash
#MISE description="Upgrade DB from every release >= 5.9.0 (Docker) to this branch's server (cargo build), populated with populate_db.sh"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-b --backend <backend>" env="BACKEND" help="Database backend" default="sqlite" {
#USAGE   choices "sqlite" "postgresql" "mysql" "redis" "all"
#USAGE }
#USAGE flag "--old-version <version>" env="OLD_VERSION" help="'all', 'nightly', or comma-separated versions" default="all"
#USAGE flag "--seed <seed>" env="SEED" help="Deterministic seed for random object generation"
#USAGE flag "--random-count <count>" env="RANDOM_COUNT" help="Number of random recipes per version" default="10"
#USAGE flag "--artifacts-dir <dir>" env="ARTIFACTS_DIR" help="Coverage reports and failure artifacts"
set -euo pipefail
# shellcheck source=.mise/lib/common.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
# shellcheck source=.mise/lib/kms_build.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/kms_build.sh"
kms_init_env "${usage_variant:-fips}" "static"

REPO_ROOT="$(get_repo_root "${MISE_CONFIG_ROOT}")"

# Build the branch once; the gate runs the binaries directly (no cargo lock contention).
# shellcheck disable=SC2119
kms_build_server
# shellcheck disable=SC2119
kms_build_cli

exec bash "${REPO_ROOT}/.mise/scripts/test/db/run_db_upgrade_gate.sh" \
  --variant "${VARIANT}" \
  --backend "${usage_backend:-sqlite}" \
  --old-version "${usage_old_version:-all}" \
  --new-kms "$(get_kms_bin)" \
  --ckms "$(get_ckms_bin)" \
  --seed "${usage_seed:-}" \
  --random-count "${usage_random_count:-10}" \
  --artifacts-dir "${usage_artifacts_dir:-${REPO_ROOT}/target/db-upgrade-all/${VARIANT}}"
