#!/usr/bin/env bash
#MISE description="Run Percona XtraDB tests"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#SUITE variants=fips,non-fips needs=nix,compose:percona ci=percona pr_variants=non-fips
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/suites.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/softhsm2.sh"
suite_init fips WITH_HSM

print_header "Running Percona tests (${VARIANT_NAME})"

# CI sets KMS_PERCONA_URL; fall back to slot-aware port default
export KMS_MYSQL_URL="${KMS_PERCONA_URL:-${KMS_MYSQL_URL:-mysql://kms:kms@127.0.0.1:${KMS_SLOT_PERCONA_PORT:-3307}/kms}}"
# Probe the Percona port, not check_and_test_db's MySQL default (3306).
: "${PERCONA_PORT:=${KMS_SLOT_PERCONA_PORT:-3307}}"

check_and_test_db "Percona" "mysql" "PERCONA_HOST" "PERCONA_PORT"
run_db_softhsm2_tests "mysql_softhsm2"

print_success "Percona tests completed"
