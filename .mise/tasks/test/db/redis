#!/usr/bin/env bash
#MISE description="Run Redis-findex tests (non-FIPS only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/softhsm2.sh"
kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging
REPO_ROOT="$(get_repo_root "${MISE_CONFIG_ROOT}")"
[ "$VARIANT" = non-fips ] || skip_test "non-fips only"
if [ "${CI:-}" != true ]; then
  has_cmd nix-shell || skip_test "nix-shell not found"
fi
export WITH_HSM=1
ensure_nix_shell
docker compose -f "${REPO_ROOT}/docker-compose.yml" up -d redis || {
  if [ "${CI:-}" = true ]; then print_error "could not start compose: redis"; fi
  skip_test "could not start compose: redis"
}

check_and_test_db "Redis" "redis" "REDIS_HOST" "REDIS_PORT"
run_db_softhsm2_tests "redis_with_findex_softhsm2"

print_success "Redis tests completed"
