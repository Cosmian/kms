#!/usr/bin/env bash
#MISE description="SQLite upgrade (old -> new KMS binary) and pre-upgrade backup restore check"
#USAGE flag "--old-kms <path>" env="OLD_KMS" help="Baseline cosmian_kms binary (e.g. built from tag 5.29.0)"
#USAGE flag "--new-kms <path>" env="NEW_KMS" help="Candidate cosmian_kms binary"
#USAGE flag "--ckms <path>" env="CKMS" help="Optional ckms binary (retained for CLI flag compatibility)"
#USAGE flag "--old-ckms <path>" env="OLD_CKMS" help="Optional old ckms binary (retained for compatibility)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "--seed <seed>" env="SEED" help="Deterministic random seed" default="424242"
#USAGE flag "--random-count <count>" env="RANDOM_COUNT" help="Number of seeded random recipes" default="8"
set -euo pipefail
# shellcheck source=.mise/lib/common.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
# shellcheck source=.mise/lib/kms_server.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/kms_server.sh"

# Upgrade proof: seed with the OLD server (fixed mig_*/bulk_* + seeded rnd_* over KMIP JSON),
# cold-copy the database, open the copy with the NEW server (verify + mutate + restart),
# then restore the pre-upgrade backup with the OLD server.

OLD_KMS="${usage_old_kms:-}"
NEW_KMS="${usage_new_kms:-}"
VARIANT="${usage_variant:-fips}"
SEED="${usage_seed:-424242}"
RANDOM_COUNT="${usage_random_count:-8}"

[ -n "${OLD_KMS}" ] || print_error "--old-kms (or OLD_KMS) is required"
[ -n "${NEW_KMS}" ] || print_error "--new-kms (or NEW_KMS) is required"
for bin in "${OLD_KMS}" "${NEW_KMS}"; do
  if [ ! -f "${bin}" ] || [ ! -x "${bin}" ]; then
    print_error "Not an executable file: ${bin}"
  fi
done
require_cmd python3
require_cmd curl

REPO_ROOT="$(get_repo_root "${MISE_CONFIG_ROOT}")"
cd "${REPO_ROOT}"
umask 077
WORK_DIR="$(mktemp -d)"
trap 'kms_stop; rm -rf -- "${WORK_DIR:?}"' EXIT

OLD_VERSION="$("${OLD_KMS}" --version 2>&1 | head -n 1)"
NEW_VERSION="$("${NEW_KMS}" --version 2>&1 | head -n 1)"
print_header "SQLite upgrade proof (${VARIANT}, seed=${SEED})"
print_status "repository HEAD: $(git rev-parse HEAD)"
for bin in "${OLD_KMS}" "${NEW_KMS}"; do
  print_status "${bin}: $("${bin}" --version 2>&1 | head -n 1) sha256=$(compute_sha256 "${bin}")"
done

HTTP_PORT="$(kms_pick_free_port)"
SOCKET_PORT="$(kms_pick_free_port)"
SERVER_URL="https://127.0.0.1:${HTTP_PORT}"
CA_CERT="${REPO_ROOT}/test_data/certificates/client_server/ca/ca.crt"
OWNER_CERT="${REPO_ROOT}/test_data/certificates/client_server/owner/owner.client.acme.com.crt"
OWNER_KEY="${REPO_ROOT}/test_data/certificates/client_server/owner/owner.client.acme.com.key"
GRANTEE_CERT="${REPO_ROOT}/test_data/certificates/client_server/user/user.client.acme.com.crt"
GRANTEE_KEY="${REPO_ROOT}/test_data/certificates/client_server/user/user.client.acme.com.key"
SERVER_CERT="${REPO_ROOT}/test_data/certificates/client_server/server/kmserver.acme.com.crt"

# Substitute scalar values in a complete test_data fixture (rule 4.20).
set_toml_value() {
  grep -qE "^$2 *= " "$1" || print_error "key '$2' missing in $1"
  sed -E "s|^($2 *= *).*|\1$3|" "$1" >"$1.tmp" && mv "$1.tmp" "$1"
}

KMS_TOML="${WORK_DIR}/kms.toml"
cp "${REPO_ROOT}/test_data/configs/server/auth/cert.toml" "${KMS_TOML}"
set_toml_value "${KMS_TOML}" port "${HTTP_PORT}"
set_toml_value "${KMS_TOML}" hostname '"127.0.0.1"'
set_toml_value "${KMS_TOML}" socket_server_port "${SOCKET_PORT}"
set_toml_value "${KMS_TOML}" root_data_path "\"${WORK_DIR}/workspace\""
set_toml_value "${KMS_TOML}" tmp_path "\"${WORK_DIR}/tmp\""
set_toml_value "${KMS_TOML}" clear_database false
set_toml_value "${KMS_TOML}" kms_public_url "\"https://localhost:${HTTP_PORT}/google_cse\""
mkdir -p "${WORK_DIR}/workspace" "${WORK_DIR}/tmp"

PHASE="init"
MANIFEST="${WORK_DIR}/manifest.json"
SNAPSHOT="${WORK_DIR}/snapshot.json"
CANARY="${WORK_DIR}/canary.json"
REPLAY_CMD="mise run test:upgrade-sqlite --old-kms ${OLD_KMS} --new-kms ${NEW_KMS} --variant ${VARIANT} --seed ${SEED}"

# Print phase and server log tail before exiting on error.
fail_phase() {
  echo "[ERROR] phase '${PHASE}': $*" >&2
  if [ -f "${WORK_DIR}/${PHASE}.log" ]; then
    echo "--- tail of ${PHASE}.log:" >&2
    tail -n 30 "${WORK_DIR}/${PHASE}.log" >&2
  fi
  exit 1
}

# Probe the mTLS KMIP endpoint until it answers HTTP 422 on an empty JSON body.
probe_mtls_kmip() {
  kill -0 "${KMS_PID}" 2>/dev/null || return 1
  local code
  code="$(curl -sS --max-time 2 -o /dev/null -w '%{http_code}' \
    --cacert "${CA_CERT}" --cert "${OWNER_CERT}" --key "${OWNER_KEY}" \
    --resolve "kmserver.acme.com:${HTTP_PORT}:127.0.0.1" \
    -X POST -H 'Content-Type: application/json' -d '{}' \
    "https://kmserver.acme.com:${HTTP_PORT}/kmip/2_1" 2>/dev/null || true)"
  [ "${code}" = "422" ]
}

# Start a KMS binary against the given SQLite directory and wait for mTLS readiness.
start_server() {
  PHASE="$1"
  set_toml_value "${KMS_TOML}" sqlite_path "\"$3\""
  # shellcheck disable=SC2034  # read by kms_start_from_bin/kms_stop (.mise/lib/kms_server.sh)
  KMS_CONFIG_FILE="${KMS_TOML}"
  # shellcheck disable=SC2034
  KMS_LOG_FILE="${WORK_DIR}/${PHASE}.log"
  # shellcheck disable=SC2034
  KMS_PORT="${HTTP_PORT}"
  # shellcheck disable=SC2034
  KMS_URL="${SERVER_URL}"
  set +o pipefail
  kms_start_from_bin "$2"
  set -o pipefail
  wait_for_command 60 probe_mtls_kmip || fail_phase "server not answering over mTLS"
}

COMMON_PY_ARGS=(
  --url "${SERVER_URL}"
  --ca-cert "${CA_CERT}"
  --client-cert "${OWNER_CERT}"
  --client-key "${OWNER_KEY}"
)
VERIFY_PY_ARGS=(
  "${COMMON_PY_ARGS[@]}"
  --grantee-cert "${GRANTEE_CERT}"
  --grantee-key "${GRANTEE_KEY}"
  --old-version "${OLD_VERSION}"
  --new-version "${NEW_VERSION}"
  --backend sqlite
  --variant "${VARIANT}"
  --replay-cmd "${REPLAY_CMD}"
)

# ── Phase 1: seed with the old server ────────────────────────────────────────
print_header "Phase 1: seed (old server)"
mkdir -p "${WORK_DIR}/db-seed"
start_server seed "${OLD_KMS}" "${WORK_DIR}/db-seed"
python3 "${REPO_ROOT}/.mise/scripts/test/populate_fixed_set.py" \
  "${COMMON_PY_ARGS[@]}" \
  --variant "${VARIANT}" \
  --manifest "${MANIFEST}" \
  --sample-cert "${SERVER_CERT}" || fail_phase "fixed-set population failed"
python3 "${REPO_ROOT}/.mise/scripts/test/verify_db_upgrade.py" populate-random \
  "${VERIFY_PY_ARGS[@]}" \
  --manifest "${MANIFEST}" \
  --seed "${SEED}" \
  --count "${RANDOM_COUNT}" \
  --sample-cert "${SERVER_CERT}" || fail_phase "random-layer population failed"
python3 "${REPO_ROOT}/.mise/scripts/test/verify_db_upgrade.py" snapshot \
  "${VERIFY_PY_ARGS[@]}" \
  --manifest "${MANIFEST}" \
  --snapshot "${SNAPSHOT}" || fail_phase "pre-upgrade snapshot failed"
kms_stop

# ── Phase 2: cold backup ─────────────────────────────────────────────────────
PHASE="backup"
print_header "Phase 2: cold backup (server stopped)"
cp -a "${WORK_DIR}/db-seed" "${WORK_DIR}/backup"
cp -a "${WORK_DIR}/backup" "${WORK_DIR}/db-candidate"

# ── Phase 3: candidate server on the copy ────────────────────────────────────
print_header "Phase 3: candidate (new server)"
start_server candidate "${NEW_KMS}" "${WORK_DIR}/db-candidate"
python3 "${REPO_ROOT}/.mise/scripts/test/verify_db_upgrade.py" verify \
  "${VERIFY_PY_ARGS[@]}" \
  --snapshot "${SNAPSHOT}" \
  --phase candidate \
  --mutate \
  --canary-file "${CANARY}" || fail_phase "candidate verification failed"
kms_stop

start_server candidate-restart "${NEW_KMS}" "${WORK_DIR}/db-candidate"
python3 "${REPO_ROOT}/.mise/scripts/test/verify_db_upgrade.py" verify \
  "${VERIFY_PY_ARGS[@]}" \
  --snapshot "${SNAPSHOT}" \
  --phase candidate-restart \
  --canary-file "${CANARY}" || fail_phase "candidate-restart verification failed"
kms_stop

# ── Phase 4: restore the pre-upgrade backup with the old server ─────────────
PHASE="restore"
print_header "Phase 4: restore (old server on the pre-upgrade backup)"
cp -a "${WORK_DIR}/backup" "${WORK_DIR}/db-restore"
start_server restore "${OLD_KMS}" "${WORK_DIR}/db-restore"
python3 "${REPO_ROOT}/.mise/scripts/test/verify_db_upgrade.py" verify \
  "${VERIFY_PY_ARGS[@]}" \
  --snapshot "${SNAPSHOT}" \
  --phase restore \
  --canary-file "${CANARY}" || fail_phase "restore verification failed"
kms_stop

print_success "SQLite upgrade from ${OLD_VERSION} and pre-upgrade backup restore verified"
