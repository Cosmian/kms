#!/usr/bin/env bash
#MISE description="Run all Kubernetes E2E tests (plugin, operator, CSI provider)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#USAGE flag "--skip-images" help="Skip Docker image tests within operator and csi-provider"
set -euo pipefail
# shellcheck source=.mise/lib/common.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
# shellcheck source=.mise/lib/k8s.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/k8s.sh"

k8s_require_tools

TASK_DIR="${MISE_CONFIG_ROOT}/.mise/tasks/test/k8s"
VARIANT="${usage_variant:-fips}"
LINK="${usage_link:-static}"
SKIP_IMAGES="${usage_skip_images:-false}"

print_header "Running all Kubernetes E2E tests (variant=${VARIANT})"

FAILED=()

run_step() {
  local name="$1"
  shift
  print_status "▶ $name"
  if bash "$@"; then
    print_success "✓ $name"
  else
    print_status "✗ $name FAILED"
    FAILED+=("$name")
  fi
}

# Each task runs its binary E2E test and (unless --skip-images) its Docker image test.
IMAGE_FLAG=()
[ "$SKIP_IMAGES" = "true" ] && IMAGE_FLAG=(--skip-image)

run_step "k8s:plugin" "${TASK_DIR}/plugin" --variant "$VARIANT" --link "$LINK"
run_step "k8s:plugin (mtls)" "${TASK_DIR}/plugin" --variant "$VARIANT" --link "$LINK" --mtls
run_step "k8s:operator" "${TASK_DIR}/operator" --variant "$VARIANT" --link "$LINK" "${IMAGE_FLAG[@]+"${IMAGE_FLAG[@]}"}"
run_step "k8s:csi-provider" "${TASK_DIR}/csi-provider" --variant "$VARIANT" --link "$LINK" "${IMAGE_FLAG[@]+"${IMAGE_FLAG[@]}"}"

if [ "${#FAILED[@]}" -gt 0 ]; then
  echo ""
  echo "FAILED tests:"
  for f in "${FAILED[@]}"; do echo "  ✗ $f"; done
  exit 1
fi

print_success "All Kubernetes E2E tests passed"
