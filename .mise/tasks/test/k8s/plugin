#!/usr/bin/env bash
#MISE description="E2E test: Kubernetes KMS Provider Plugin (etcd Secret encryption, issue #861)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#USAGE flag "--mtls" env="K8S_MTLS" help="Deploy the KMS with TLS + client-certificate (mutual TLS) and drive the plugin over an mTLS channel"
set -euo pipefail
# shellcheck source=.mise/lib/common.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
# shellcheck source=.mise/lib/k8s.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/k8s.sh"

MTLS="${usage_mtls:-${K8S_MTLS:-false}}"
NAMESPACE="kms-plugin-e2e"
RELEASE="my-kms"
SOCK_DIR="/var/run/cosmian-kms-plugin"
SOCK_PATH="${SOCK_DIR}/kms.sock"
CFG_DIR="/etc/cosmian-kms-plugin"
CLIENT_EMAIL="plugin@cosmian.com"

print_header "KMS plugin E2E (mtls=${MTLS})"
k8s_require_tools

WORK=$(mktemp -d)
PLUGIN_BIN=$(k8s_locate_bin cosmian_kms_k8s_plugin cosmian-kms-plugin)
CKMS_BIN=$(k8s_locate_bin ckms ckms)

cleanup() {
  local rc=$?
  [ $rc -ne 0 ] && k8s_dump_debug "$NAMESPACE" "$RELEASE" cosmian-kms-plugin
  if [ -n "${PF_PID:-}" ]; then kill "$PF_PID" 2>/dev/null || true; fi
  rm -rf "$WORK"
  return $rc
}
trap cleanup EXIT

# ── 1. Deploy KMS (plain HTTP, or TLS + client-CA for mTLS) ───────────────────
SCHEME="http"
if [ "$MTLS" = "true" ]; then
  SCHEME="https"
  # ClusterIP is not known until the Service exists, so deploy first with a
  # placeholder, capture the IP, regenerate the server cert with the right SAN,
  # then upgrade. Simpler: reserve the IP by creating the Service via a first
  # install without TLS, capture IP, generate PKI, then `helm upgrade` with TLS.
  print_status "mTLS mode: bootstrapping to discover ClusterIP..."
  k8s_deploy_kms "$NAMESPACE" "$RELEASE"
  CLUSTER_IP=$(k8s_kms_cluster_ip "$NAMESPACE" "$RELEASE")
  k8s_gen_pki "$WORK" "${RELEASE}-cosmian-kms.${NAMESPACE}.svc" "$CLUSTER_IP" "$CLIENT_EMAIL"

  kubectl create secret tls kms-server-tls -n "$NAMESPACE" \
    --cert="$WORK/server.crt" --key="$WORK/server.key" \
    --dry-run=client -o yaml | kubectl apply -f -
  kubectl create secret generic kms-client-ca -n "$NAMESPACE" \
    --from-file=ca.crt="$WORK/ca.crt" \
    --dry-run=client -o yaml | kubectl apply -f -

  # Probes must speak HTTPS once TLS is on; the KMS only requests (does not
  # require) client certs, so an httpGet probe without a client cert still works.
  cat >"$WORK/mtls-values.yaml" <<'YAML'
kms:
  tls:
    enabled: true
    existingSecret: kms-server-tls
extraArgs:
  - --clients-ca-cert-file
  - /etc/cosmian-kms/client-ca/ca.crt
extraVolumes:
  - name: client-ca
    secret:
      secretName: kms-client-ca
extraVolumeMounts:
  - name: client-ca
    mountPath: /etc/cosmian-kms/client-ca
    readOnly: true
startupProbe:
  httpGet: { path: /health, port: http, scheme: HTTPS }
  failureThreshold: 30
  periodSeconds: 5
livenessProbe:
  httpGet: { path: /health, port: http, scheme: HTTPS }
  periodSeconds: 10
readinessProbe:
  httpGet: { path: /health, port: http, scheme: HTTPS }
  periodSeconds: 10
YAML
  helm upgrade "$RELEASE" "${MISE_CONFIG_ROOT}/charts/cosmian-kms" \
    --namespace "$NAMESPACE" -f "$WORK/mtls-values.yaml" \
    --set kms.database.type=sqlite --set image.tag="${KMS_IMAGE_TAG:-latest}" \
    --wait --timeout 180s
else
  k8s_deploy_kms "$NAMESPACE" "$RELEASE"
  CLUSTER_IP=$(k8s_kms_cluster_ip "$NAMESPACE" "$RELEASE")
fi
print_status "KMS ClusterIP: $CLUSTER_IP"

# ── 2. Create the wrapping key (KEK) via port-forward ─────────────────────────
kubectl port-forward -n "$NAMESPACE" "svc/${RELEASE}-cosmian-kms" 9998:9998 &
PF_PID=$!
k8s_wait_kms_http "${SCHEME}://localhost:9998/version" 30

if [ "$MTLS" = "true" ]; then
  CKMS_CONF=$(k8s_ckms_conf "$WORK" "https://localhost:9998" "$WORK/client.crt" "$WORK/client.key")
else
  CKMS_CONF=$(k8s_ckms_conf "$WORK" "http://localhost:9998")
fi
KEK_UID=$(k8s_create_kek "$CKMS_BIN" "$CKMS_CONF" kms-plugin-kek)
print_status "Created KEK: $KEK_UID"

# ── 3. Install the plugin binary + config on the Minikube node ────────────────
k8s_install_node_bin "$PLUGIN_BIN" /usr/local/bin/cosmian-kms-plugin
minikube ssh -- sudo mkdir -p "$CFG_DIR"

if [ "$MTLS" = "true" ]; then
  minikube ssh -- sudo mkdir -p "$CFG_DIR/tls"
  for f in ca.crt client.crt client.key; do
    minikube cp "$WORK/$f" "/tmp/$f"
    minikube ssh -- sudo cp "/tmp/$f" "$CFG_DIR/tls/$f"
  done
  cat >"$WORK/config.yaml" <<EOF
cosmian_kms:
  server_url: https://${CLUSTER_IP}:9998
  ca_cert: ${CFG_DIR}/tls/ca.crt
  tls_cert: ${CFG_DIR}/tls/client.crt
  tls_key: ${CFG_DIR}/tls/client.key
  wrapping_key_uid: ${KEK_UID}
  socket_path: ${SOCK_PATH}
EOF
else
  cat >"$WORK/config.yaml" <<EOF
cosmian_kms:
  server_url: http://${CLUSTER_IP}:9998
  wrapping_key_uid: ${KEK_UID}
  socket_path: ${SOCK_PATH}
EOF
fi
minikube cp "$WORK/config.yaml" /tmp/plugin-config.yaml
minikube ssh -- sudo cp /tmp/plugin-config.yaml "$CFG_DIR/config.yaml"

# ── 4. Start the plugin as a systemd service ──────────────────────────────────
k8s_write_systemd_unit cosmian-kms-plugin "$(
  cat <<UNIT
[Unit]
Description=Cosmian KMS Kubernetes Plugin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cosmian-kms-plugin --config ${CFG_DIR}/config.yaml
Restart=on-failure
RestartSec=5s
RuntimeDirectory=cosmian-kms-plugin
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
UNIT
)"
k8s_wait_node_socket "$SOCK_PATH" 60

# ── 5. Enable etcd encryption on kube-apiserver ───────────────────────────────
minikube ssh -- sudo mkdir -p /etc/kubernetes/enc
cat >"$WORK/encryption-config.yaml" <<'EOF'
apiVersion: apiserver.config.k8s.io/v1
kind: EncryptionConfiguration
resources:
  - resources:
      - secrets
    providers:
      - kms:
          apiVersion: v2
          name: cosmian-kms
          endpoint: unix:///var/run/cosmian-kms-plugin/kms.sock
          timeout: 5s
      - identity: {}
EOF
minikube cp "$WORK/encryption-config.yaml" /etc/kubernetes/enc/config.yaml

minikube ssh -- sudo apt-get update -qq
minikube ssh -- sudo apt-get install -y python3-yaml -qq
minikube cp "${MISE_CONFIG_ROOT}/.github/scripts/patch-kube-apiserver.py" /tmp/patch-apiserver.py
minikube ssh -- sudo python3 /tmp/patch-apiserver.py

print_status "Waiting for kube-apiserver to restart with encryption enabled..."
sleep 15
timeout 180 bash -c \
  'until kubectl get nodes --request-timeout=5s >/dev/null 2>&1; do sleep 5; done' ||
  print_error "kube-apiserver did not come back"
timeout 120 bash -c \
  'until kubectl get --raw "/healthz/kms-providers" 2>/dev/null | grep -q "^ok$"; do sleep 5; done' ||
  print_error "KMS provider did not become healthy"
print_success "KMS provider is healthy"

# ── 6. TEST: secret is stored, encrypted at rest, and decrypts correctly ──────
SECRET_PLAINTEXT="supersecret-$(date +%s)"
kubectl create secret generic cosmian-test-secret \
  --from-literal=password="$SECRET_PLAINTEXT"

RAW=$(kubectl exec -n kube-system etcd-minikube -- \
  etcdctl --endpoints=https://127.0.0.1:2379 \
  --cacert=/var/lib/minikube/certs/etcd/ca.crt \
  --cert=/var/lib/minikube/certs/etcd/server.crt \
  --key=/var/lib/minikube/certs/etcd/server.key \
  get /registry/secrets/default/cosmian-test-secret 2>&1 | cat)
echo "$RAW" | grep -q "k8s:enc:kms:v2:cosmian-kms:" ||
  {
    echo "$RAW"
    print_error "secret is NOT encrypted in etcd"
  }
print_success "etcd value is encrypted (k8s:enc:kms:v2:cosmian-kms: prefix present)"

# Content assertion: the decrypted value round-trips exactly.
VALUE=$(kubectl get secret cosmian-test-secret -o jsonpath='{.data.password}' | base64 -d)
[ "$VALUE" = "$SECRET_PLAINTEXT" ] ||
  print_error "decrypted value '$VALUE' != '$SECRET_PLAINTEXT'"
print_success "secret decrypts to the exact expected plaintext"

# ── 7. TEST: plugin restart durability (no plaintext DEK persisted) ───────────
# Restart the plugin process, then decrypt a secret written BEFORE the restart.
# Success proves the wrapped DEK in etcd is re-unwrapped from scratch and no
# plaintext DEK was cached across the restart.
print_status "Restarting plugin to test durability across restarts..."
k8s_restart_node_service cosmian-kms-plugin
k8s_wait_node_socket "$SOCK_PATH" 30
timeout 60 bash -c \
  'until kubectl get --raw "/healthz/kms-providers" 2>/dev/null | grep -q "^ok$"; do sleep 3; done' ||
  print_error "KMS provider not healthy after plugin restart"
VALUE_AFTER=$(kubectl get secret cosmian-test-secret -o jsonpath='{.data.password}' | base64 -d)
[ "$VALUE_AFTER" = "$SECRET_PLAINTEXT" ] ||
  print_error "after restart, decrypted value '$VALUE_AFTER' != '$SECRET_PLAINTEXT'"
print_success "secret still decrypts after plugin restart (no data loss)"

# ── 8. TEST: Status() degraded path ──────────────────────────────────────────
# Stopping the plugin must make the kube-apiserver kms-providers healthz report
# NOT-ok within a bounded window; restarting must recover it.
print_status "Stopping plugin to verify degraded health is reported..."
k8s_stop_node_service cosmian-kms-plugin
# shellcheck disable=SC2016
# Single quotes are intentional: $() must expand inside the bash -c subprocess, not in the current shell.
if timeout 150 bash -c \
  'until [ "$(kubectl get --raw "/healthz/kms-providers" 2>&1 | tr -d "[:space:]")" != "ok" ]; do sleep 3; done'; then
  print_success "kms-providers healthz correctly reports degraded when plugin is down"
else
  print_error "kms-providers healthz stayed ok after the plugin was stopped"
fi

print_status "Restarting plugin to verify health recovery..."
minikube ssh -- sudo systemctl start cosmian-kms-plugin
k8s_wait_node_socket "$SOCK_PATH" 30
timeout 180 bash -c \
  'until kubectl get --raw "/healthz/kms-providers" 2>/dev/null | grep -q "^ok$"; do sleep 3; done' ||
  print_error "KMS provider did not recover after restart"
print_success "kms-providers healthz recovered after plugin restart"

print_success "KMS plugin E2E completed (mtls=${MTLS})"
