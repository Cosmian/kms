#!/usr/bin/env bash
#MISE description="E2E test: KMS CSI Provider — secrets store mount via Docker image DaemonSet (Minikube)"
# The CSI provider is tested exclusively via its published Docker image, deployed
# as a Kubernetes DaemonSet in kube-system — matching the production topology.
#
# Prerequisites: a running Minikube cluster + result-k8s-csi-provider-image (Nix tarball).
set -euo pipefail
# shellcheck source=.mise/lib/common.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
# shellcheck source=.mise/lib/k8s.sh
source "${MISE_CONFIG_ROOT}/.mise/lib/k8s.sh"

NAMESPACE="kms-csi-e2e"
RELEASE="csi-kms"
PROVIDER_SOCK_DIR="/etc/kubernetes/secrets-store-csi-providers"
PROVIDER_SOCK="${PROVIDER_SOCK_DIR}/cosmian-kms.sock"
CFG_NAME="cosmian-kms-csi-config"
DS_NAME="cosmian-kms-csi-provider"
IMAGE_NAME="cosmian-kms-csi-provider"

print_header "CSI Provider E2E (Docker image)"
k8s_require_tools

REPO_ROOT="${MISE_CONFIG_ROOT}"
WORK=$(mktemp -d)
CKMS_BIN=$(k8s_locate_bin ckms ckms)

# ── Load the published Docker image into Minikube ─────────────────────────────
OUT_LINK="${REPO_ROOT}/result-k8s-csi-provider-image"
if [ ! -e "$OUT_LINK" ]; then
  print_status "CSI provider image tarball not found — building via Nix..."
  mise run build:k8s-csi-provider-image
fi
IMAGE_TAR=$(readlink -f "$OUT_LINK")
[ -f "$IMAGE_TAR" ] || print_error "CSI provider image tarball not found at $IMAGE_TAR"

print_status "Loading CSI provider image into Minikube..."
minikube image load "$IMAGE_TAR"
LOADED=$(docker load <"$IMAGE_TAR" 2>&1 | grep -oE 'Loaded image( ID)?: \S+' | awk '{print $NF}' | head -1)
IMAGE_REF="${LOADED:-${IMAGE_NAME}:latest}"
print_status "Image loaded as: $IMAGE_REF"

cleanup() {
  local rc=$?
  if [ $rc -ne 0 ]; then
    k8s_dump_debug "$NAMESPACE" "$RELEASE"
    echo "--- CSI provider DaemonSet pod logs (kube-system) ---"
    kubectl logs -n kube-system -l "app=${DS_NAME}" --tail=100 2>&1 || true
    echo "--- CSI provider DaemonSet pod description ---"
    kubectl describe pod -n kube-system -l "app=${DS_NAME}" 2>&1 || true
  fi
  if [ -n "${PF_PID:-}" ]; then kill "$PF_PID" 2>/dev/null || true; fi
  kubectl delete pod csi-known-pod csi-rotate-pod csi-revoked-pod \
    --ignore-not-found=true 2>/dev/null || true
  kubectl delete secretproviderclass cosmian-known cosmian-rotate cosmian-revoked \
    --ignore-not-found=true 2>/dev/null || true
  kubectl delete daemonset "$DS_NAME" -n kube-system --ignore-not-found=true 2>/dev/null || true
  kubectl delete configmap "$CFG_NAME" -n kube-system --ignore-not-found=true 2>/dev/null || true
  k8s_teardown "$NAMESPACE" "$RELEASE"
  rm -rf "$WORK"
  return $rc
}
trap cleanup EXIT

# ── helper: read a mounted file's bytes from a test pod as hex ───────────────
pod_file_hex() {
  local pod="$1" path="$2"
  kubectl exec "$pod" -- sh -c "od -An -tx1 '$path' | tr -d ' \n'"
}

# ── 1. Deploy KMS + the upstream Secrets Store CSI Driver ─────────────────────
k8s_deploy_kms "$NAMESPACE" "$RELEASE"
CLUSTER_IP=$(k8s_kms_cluster_ip "$NAMESPACE" "$RELEASE")
print_status "KMS ClusterIP: $CLUSTER_IP"

helm repo add secrets-store-csi-driver \
  https://kubernetes-sigs.github.io/secrets-store-csi-driver/charts 2>/dev/null || true
helm repo update secrets-store-csi-driver >/dev/null
helm upgrade --install csi-secrets-store secrets-store-csi-driver/secrets-store-csi-driver \
  --namespace kube-system \
  --set syncSecret.enabled=false \
  --set enableSecretRotation=true \
  --set rotationPollInterval=30s \
  --wait --timeout 120s
print_success "Secrets Store CSI Driver installed"

# ── 2. Pre-populate the KMS with test objects ─────────────────────────────────
kubectl port-forward -n "$NAMESPACE" "svc/${RELEASE}-cosmian-kms" 9998:9998 &
PF_PID=$!
k8s_wait_kms_http "http://localhost:9998/version" 30
CKMS_CONF=$(k8s_ckms_conf "$WORK" "http://localhost:9998")

SECRET_VALUE="csi-secret-value-$(date +%s)"
SECRET_UID=$(k8s_create_secret "$CKMS_BIN" "$CKMS_CONF" "$SECRET_VALUE" csi-known-secret)
print_status "Created SecretData: $SECRET_UID"

ROTATE_UID_V1=$(k8s_create_kek "$CKMS_BIN" "$CKMS_CONF" csi-rotate-key-v1)
ROTATE_UID_V2=$(k8s_create_kek "$CKMS_BIN" "$CKMS_CONF" csi-rotate-key-v2)
print_status "Created rotation keys: v1=$ROTATE_UID_V1 v2=$ROTATE_UID_V2"

REVOKE_VALUE="revoke-me-$(date +%s)"
REVOKE_UID=$(k8s_create_secret "$CKMS_BIN" "$CKMS_CONF" "$REVOKE_VALUE" csi-revoke-secret)
k8s_revoke_object "$CKMS_BIN" "$CKMS_CONF" "$REVOKE_UID"
print_status "Created+revoked: $REVOKE_UID"

kill "$PF_PID" 2>/dev/null || true
unset PF_PID

# ── 3. Deploy CSI provider as a DaemonSet (Docker image, kube-system ns) ──────
# The DaemonSet mounts the provider socket directory from the host node (hostPath)
# so the Secrets Store CSI Driver can discover and call the provider via gRPC.
# imagePullPolicy: Never forces Minikube to use the locally-loaded Nix image.
print_status "Creating CSI provider ConfigMap and DaemonSet..."
kubectl create configmap "$CFG_NAME" -n kube-system \
  --from-literal=config.yaml="$(
    cat <<EOF
cosmian_kms:
  server_url: http://${CLUSTER_IP}:9998
  socket_path: ${PROVIDER_SOCK}
EOF
  )" --dry-run=client -o yaml | kubectl apply -f -

kubectl apply -f - <<EOF
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: ${DS_NAME}
  namespace: kube-system
spec:
  selector:
    matchLabels:
      app: ${DS_NAME}
  template:
    metadata:
      labels:
        app: ${DS_NAME}
    spec:
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      containers:
        - name: provider
          image: ${IMAGE_REF}
          imagePullPolicy: Never
          args:
            - --config
            - /etc/cosmian-kms-csi/config.yaml
          securityContext:
            privileged: true
          volumeMounts:
            - name: config
              mountPath: /etc/cosmian-kms-csi
            - name: provider-socket-dir
              mountPath: ${PROVIDER_SOCK_DIR}
      volumes:
        - name: config
          configMap:
            name: ${CFG_NAME}
        - name: provider-socket-dir
          hostPath:
            path: ${PROVIDER_SOCK_DIR}
            type: DirectoryOrCreate
EOF

# Wait for DaemonSet to be ready and for the socket to appear on the node
kubectl rollout status daemonset/"$DS_NAME" -n kube-system --timeout=120s ||
  print_error "CSI provider DaemonSet did not become ready"
k8s_wait_node_socket "$PROVIDER_SOCK" 30
print_success "CSI provider DaemonSet ready, socket available"

# ── helper: apply a SecretProviderClass with a single object ─────────────────
apply_spc() {
  local name="$1" object_name="$2" uid="$3"
  kubectl apply -f - <<EOF
apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: ${name}
spec:
  provider: cosmian-kms
  parameters:
    objects: |
      - objectName: ${object_name}
        kmsUID: ${uid}
        objectVersion: ""
EOF
}

# ── helper: deploy a pod mounting a SecretProviderClass ──────────────────────
apply_pod() {
  local pod="$1" spc="$2"
  kubectl apply -f - <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: ${pod}
spec:
  containers:
    - name: test
      image: busybox:1.36
      imagePullPolicy: IfNotPresent
      command: ["sleep", "600"]
      volumeMounts:
        - name: secrets-vol
          mountPath: /mnt/secrets
          readOnly: true
  volumes:
    - name: secrets-vol
      csi:
        driver: secrets-store.csi.k8s.io
        readOnly: true
        volumeAttributes:
          secretProviderClass: ${spc}
EOF
}

# ── 4. TEST: mounted file content equals the exact KMS secret value ──────────
apply_spc cosmian-known known-secret "$SECRET_UID"
apply_pod csi-known-pod cosmian-known
kubectl wait pod/csi-known-pod --for=condition=Ready --timeout=180s ||
  print_error "csi-known-pod did not become Ready"

MOUNTED=$(kubectl exec csi-known-pod -- cat /mnt/secrets/known-secret)
[ "$MOUNTED" = "$SECRET_VALUE" ] ||
  print_error "mounted content '${MOUNTED}' != expected '${SECRET_VALUE}'"
print_success "CSI mounted file content matches the exact KMS secret value"

# ── 5. TEST: live rotation — re-point the SPC to the rotated key's new UID ────
apply_spc cosmian-rotate rotate-key "$ROTATE_UID_V1"
apply_pod csi-rotate-pod cosmian-rotate
kubectl wait pod/csi-rotate-pod --for=condition=Ready --timeout=180s ||
  print_error "csi-rotate-pod did not become Ready"
BYTES_BEFORE=$(pod_file_hex csi-rotate-pod /mnt/secrets/rotate-key)
[ -n "$BYTES_BEFORE" ] || print_error "rotate-key file empty before rotation"

print_status "Rotating: re-pointing SPC to $ROTATE_UID_V2 (poll interval 30s)..."
apply_spc cosmian-rotate rotate-key "$ROTATE_UID_V2"

ROTATED=false
for _ in $(seq 1 30); do
  sleep 10
  BYTES_AFTER=$(pod_file_hex csi-rotate-pod /mnt/secrets/rotate-key 2>/dev/null || true)
  if [ -n "$BYTES_AFTER" ] && [ "$BYTES_AFTER" != "$BYTES_BEFORE" ]; then
    ROTATED=true
    break
  fi
done
[ "$ROTATED" = "true" ] ||
  print_error "rotation not reflected in-place within the reconcile window"
print_success "CSI reflects KMS rotation live (in-place file update after SPC re-point)"

# ── 6. TEST: graceful failure when the KMS object is revoked/destroyed ────────
apply_spc cosmian-revoked revoked-secret "$REVOKE_UID"
apply_pod csi-revoked-pod cosmian-revoked
if kubectl wait pod/csi-revoked-pod --for=condition=Ready --timeout=45s 2>/dev/null; then
  print_error "csi-revoked-pod unexpectedly became Ready after the secret was revoked"
fi
EVENTS=$(kubectl describe pod csi-revoked-pod 2>&1 | cat)
echo "$EVENTS" | grep -qiE "failed|error|mount" ||
  print_warning "no explicit mount-failure event found (pod correctly stayed not-Ready)"
print_success "CSI mount fails gracefully for a revoked KMS object (pod stayed not-Ready)"

print_success "KMS CSI Provider E2E completed (Docker image)"
