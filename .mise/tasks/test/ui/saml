#!/usr/bin/env bash
#MISE description="Run the SAML single sign-on E2E test (Keycloak + Auth Verifier SAML + KMS, Docker)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#SUITE variants=non-fips needs=nix,docker,file:authentication/server/auth_verifier.dev.toml
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/suites.sh"
suite_init non-fips WITH_WASM WITH_CURL

bash "${REPO_ROOT}/.mise/scripts/test/test_ui_saml.sh" --variant "${VARIANT}" --link "${LINK}"
