#!/usr/bin/env bash
#MISE description="Run the nix_helpers.sh re-entry regression test (secrets must not reach nix-shell arguments)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
kms_init_env "${usage_variant:-fips}" "${usage_link:-static}"
# The helper does not depend on the variant: run it once, as the original CI step did.
[ "${VARIANT}" = non-fips ] || skip_test "variant-independent, runs in the non-fips leg only"

print_header "Running nix_helpers.sh re-entry test"

# shellcheck disable=SC2119  # get_repo_root intentionally receives no task arguments
REPO_ROOT="$(get_repo_root)"
bash "${REPO_ROOT}/.mise/scripts/test/test_nix_helpers.sh"

print_success "nix_helpers.sh re-entry test completed"
