#!/usr/bin/env bash
#MISE description="Ingest a KMS JSONL audit file into an ephemeral OpenSearch container and verify compatibility"
#USAGE flag "-f --file <file>" env="AUDIT_FILE" help="Path to the KMS JSONL audit file" default=".mise/scripts/test/fixtures/sample-audit.jsonl"
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/audit_compat.sh"

print_header "OpenSearch audit JSONL compatibility test"

audit_compat_require_common_cmds "OpenSearch"

REPO_ROOT="$(get_repo_root)"
AUDIT_FILE="${usage_file:-${REPO_ROOT}/.mise/scripts/test/fixtures/sample-audit.jsonl}"
OPENSEARCH_HOST=127.0.0.1
OPENSEARCH_PORT=9200
CONTAINER_NAME="kms-audit-compat-opensearch-$$"
audit_compat_container_cleanup_trap "${CONTAINER_NAME}"

print_status "Starting ephemeral OpenSearch container (no volume, --rm)"
# Pinned to the current stable release (not :latest) so this test stays reproducible;
# bump deliberately when a new OpenSearch major/minor ships, see release notes:
# https://github.com/opensearch-project/OpenSearch/releases
docker run -d --rm --name "${CONTAINER_NAME}" \
  -p "${OPENSEARCH_PORT}:9200" \
  -e "discovery.type=single-node" \
  -e "DISABLE_SECURITY_PLUGIN=true" \
  -e "OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m" \
  opensearchproject/opensearch:3.8.0 >/dev/null

print_status "Waiting for OpenSearch to accept connections"
if ! wait_for_port "${OPENSEARCH_HOST}" "${OPENSEARCH_PORT}" 90; then
  print_error "OpenSearch did not open port ${OPENSEARCH_PORT} in time"
fi

print_status "Waiting for cluster health (green/yellow)"
for _ in $(seq 1 60); do
  status=$(curl -fsS "http://${OPENSEARCH_HOST}:${OPENSEARCH_PORT}/_cluster/health" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("status",""))' 2>/dev/null || true)
  [ "${status}" = "green" ] || [ "${status}" = "yellow" ] && break
  sleep 1
done
if [ "${status:-}" != "green" ] && [ "${status:-}" != "yellow" ]; then
  print_error "OpenSearch cluster never reached a usable health status"
fi

PYTHON_BIN=$(audit_compat_python "${REPO_ROOT}")

"${PYTHON_BIN}" "${REPO_ROOT}/.mise/scripts/test/validate_audit_compat.py" \
  --backend opensearch \
  --file "${AUDIT_FILE}" \
  --fields-file "${REPO_ROOT}/schemas/kms-audit-fields.json" \
  --mapping-file "${REPO_ROOT}/schemas/kms-audit-mapping.json" \
  --host "${OPENSEARCH_HOST}" \
  --port "${OPENSEARCH_PORT}"

print_success "OpenSearch audit JSONL compatibility test passed"
