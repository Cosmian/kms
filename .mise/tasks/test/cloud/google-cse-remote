#!/usr/bin/env bash
#MISE description="Local only (never CI): ckms tests against cse.cosmian.com and cse.test.cosmian.com (login, Gmail CSE identities and key pairs)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging

# Local only (#1435): needs personal credentials, and Google flags logins from CI runners as suspicious.
[ -z "${CI:-}" ] || skip_test "local only: never run in CI (#1435)"

[ "${VARIANT}" = non-fips ] || skip_test "remote tests do not depend on the client variant: run with --variant non-fips"

# Skipped when already set: this block runs again after the nix-shell re-exec.
if [ -z "${CKMS_CSE_CONF:-}" ]; then
  CKMS_CSE_CONF="${HOME}/.cosmian/cse.cosmian.com.toml"
  [ -f "${CKMS_CSE_CONF}" ] || skip_test "set CKMS_CSE_CONF or create ~/.cosmian/cse.cosmian.com.toml"
  export CKMS_CSE_CONF
fi

# The two login tests exchange a saved refresh_token; only a browser `ckms login oauth` creates one.
SKIP_ARGS=()
if ! grep -q '^refresh_token[[:space:]]*=' "${CKMS_CSE_CONF}"; then
  print_warning "no refresh_token in ${CKMS_CSE_CONF}: skipping the 2 login tests (add \"offline_access\" to oauth2_conf.scopes, then run 'CKMS_CONF=${CKMS_CSE_CONF} ckms login oauth' once)"
  SKIP_ARGS=(--skip remote_cse_login_with_refresh_token --skip remote_cse_key_pair_create_dry_run)
fi

has_cmd nix-shell || skip_test "nix-shell not found"

# shellcheck disable=SC2119  # ensure_nix_shell intentionally called without args here
ensure_nix_shell

print_header "Running remote Google CSE ckms tests"

require_cmd cargo

# The tests drive the prebuilt binary; rebuild so a stale one is not reused.
cargo build -p ckms --bin ckms ${FEATURES_FLAG[@]+"${FEATURES_FLAG[@]}"}
cargo test -p ckms ${FEATURES_FLAG[@]+"${FEATURES_FLAG[@]}"} google_cmd::remote_cse -- --ignored ${SKIP_ARGS[@]+"${SKIP_ARGS[@]}"}

print_success "Remote Google CSE ckms tests completed"
