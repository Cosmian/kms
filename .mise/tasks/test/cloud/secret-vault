#!/usr/bin/env bash
#MISE description="Run secret backend integration tests against HashiCorp Vault (non-FIPS only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#SUITE variants=non-fips needs=docker ci=secrets scope=upstream
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/suites.sh"
suite_init non-fips

print_header "Running secret backend tests: HashiCorp Vault (${VARIANT_NAME})"

bash "${MISE_CONFIG_ROOT}/.mise/scripts/test/test_secret_vault.sh" \
  --variant "${usage_variant:-non-fips}" --link "${usage_link:-static}"

print_success "Secret Vault tests completed"
