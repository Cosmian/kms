#!/usr/bin/env bash
#MISE description="Run AWS XKS tests (non-FIPS only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/nix_helpers.sh"
source "${MISE_CONFIG_ROOT}/.mise/lib/kms_server.sh"
kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging
REPO_ROOT="$(get_repo_root "${MISE_CONFIG_ROOT}")"
[ "$VARIANT" = non-fips ] || skip_test "non-fips only"
if [ "${CI:-}" != true ]; then
  has_cmd nix-shell || skip_test "nix-shell not found"
fi
export WITH_XKS=1 WITH_CURL=1
ensure_nix_shell

print_header "Running AWS XKS tests"

# Delegate to the existing XKS test script (curl + SigV4)
bash "${REPO_ROOT}/.mise/scripts/test/test_xks.sh" --variant "$VARIANT" --link "$LINK"

print_success "AWS XKS tests completed"
