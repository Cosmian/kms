#!/usr/bin/env bash
#MISE description="Run secret backend integration tests against AWS SSM Parameter Store (non-FIPS only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
#SUITE variants=non-fips needs=env:AWS_ACCESS_KEY_ID,env:AWS_SECRET_ACCESS_KEY,env:AWS_REGION scope=upstream
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/suites.sh"
suite_init non-fips

# Validate required AWS credentials
for var in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION; do
  if [ -z "${!var:-}" ]; then
    print_error "Required env var $var is not set. AWS SSM tests require IAM credentials."
  fi
done

print_header "Running secret backend tests: AWS SSM (${VARIANT_NAME})"

bash "${MISE_CONFIG_ROOT}/.mise/scripts/test/test_secret_aws.sh" \
  --variant "${usage_variant:-non-fips}" --link "${usage_link:-static}"

print_success "Secret AWS tests completed"
