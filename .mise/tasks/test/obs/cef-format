#!/usr/bin/env bash
#MISE description="Run CEF v27 format validation test"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="Feature variant (must be non-fips)" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#SUITE variants=non-fips ci=blackbox
# Proves CEF v27 format, extension keys, 1:1 mapping, outcome coverage.
# Requires non-fips: CEF export is only available in non-fips builds.
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/suites.sh"

suite_init non-fips

print_header "Running CEF format validation test (${VARIANT_NAME})"

bash "${REPO_ROOT}/.mise/scripts/test/test_cef_format.sh" --variant "${VARIANT}"

print_success "CEF format validation test completed"
