#!/usr/bin/env bash
#MISE description="Run CEF-over-TCP-syslog SIEM integration test (rsyslog)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="Feature variant (must be non-fips)" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
# SIEM tests require non-fips: CEF export and audit middleware use non-fips features.
# Uses Docker containers (rsyslog) + KMS binary (self-builds OpenSSL). No Nix shell needed.
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging
REPO_ROOT="$(get_repo_root "${MISE_CONFIG_ROOT}")"
[ "$VARIANT" = non-fips ] || skip_test "non-fips only"
if [ "${CI:-}" != true ]; then
  docker_ready || skip_test "Docker is not running"
fi

print_header "Running CEF-over-TCP-syslog SIEM integration test (${VARIANT_NAME})"

bash "${REPO_ROOT}/.mise/scripts/test/test_siem_cef_tcp_syslog.sh" --variant "$VARIANT"

print_success "CEF-over-TCP-syslog SIEM test completed"
