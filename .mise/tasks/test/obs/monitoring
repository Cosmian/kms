#!/usr/bin/env bash
#MISE description="Run monitoring stack integration test (VictoriaMetrics + Grafana)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="Feature variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
# Proves monitoring stack: OTel collector → VictoriaMetrics → Grafana.
# KMS metrics (kms_server_uptime_seconds_total, kms_database_operations_total)
# must be queryable from VictoriaMetrics. Grafana /api/health must return 200.
# Requires Docker: otel/opentelemetry-collector-contrib, victoriametrics/victoria-metrics,
#   grafana/grafana.
# Works with both fips and non-fips (OTLP metrics are not feature-gated).
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging
REPO_ROOT="$(get_repo_root "${MISE_CONFIG_ROOT}")"
if [ "${CI:-}" != true ]; then
  docker_ready || skip_test "Docker is not running"
fi

print_header "Running monitoring stack integration test (${VARIANT_NAME})"
echo "Purpose: prove KMS metrics flow OTel → VictoriaMetrics, Grafana healthy"

bash "${REPO_ROOT}/.mise/scripts/test/test_monitoring.sh" --variant "${VARIANT}"

print_success "Monitoring stack integration test completed"
