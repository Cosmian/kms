#!/usr/bin/env bash
#MISE description="Run CEF-over-syslog SIEM integration test"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="Feature variant (must be non-fips)" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#SUITE variants=non-fips needs=docker
# SIEM tests require non-fips: CEF export and audit middleware use non-fips features.
# Uses Docker containers + KMS binary (self-builds OpenSSL). No Nix shell needed.
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/suites.sh"

suite_init non-fips

print_header "Running CEF-over-syslog SIEM integration test (${VARIANT_NAME})"

bash "${REPO_ROOT}/.mise/scripts/test/test_siem_cef_syslog.sh" --variant "$VARIANT"

print_success "CEF-over-syslog SIEM test completed"
