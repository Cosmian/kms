#!/usr/bin/env bash
#MISE description="Run secret backend integration tests against Azure Key Vault (non-FIPS only)"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"
kms_init_env "${usage_variant:-non-fips}" "${usage_link:-static}"
setup_test_logging

# Validate required Azure credentials
for var in AZURE_TENANT_ID AZURE_CLIENT_ID AZURE_CLIENT_SECRET AZURE_KV_NAME; do
  if [ -z "${!var:-}" ]; then
    print_error "Required env var $var is not set. Azure Key Vault tests require service-principal credentials."
  fi
done

print_header "Running secret backend tests: Azure Key Vault (${VARIANT_NAME})"

bash "${MISE_CONFIG_ROOT}/.mise/scripts/test/test_secret_azure.sh" \
  --variant "${usage_variant:-non-fips}" --link "${usage_link:-static}"

print_success "Secret Azure tests completed"
