#!/usr/bin/env bash
#MISE description="Run a full, independent PKCS#11 v2/v3 conformance suite against cosmian_pkcs11 (pkcs11-tool + a raw-ABI ctypes harness) — every implemented mechanism against every applicable function"
#USAGE flag "-v --variant <variant>" env="VARIANT" help="FIPS variant" default="non-fips" {
#USAGE   choices "fips" "non-fips"
#USAGE }
#USAGE flag "-l --link <link>" env="LINK" help="Linkage type" default="static" {
#USAGE   choices "static" "dynamic"
#USAGE }
set -euo pipefail
source "${MISE_CONFIG_ROOT}/.mise/lib/common.sh"

print_header "Running independent PKCS#11 v2/v3 conformance suite (cosmian_pkcs11)"

REPO_ROOT="$(get_repo_root)"
bash "${REPO_ROOT}/.mise/scripts/test/test_pkcs11_conformance.sh" \
  --variant "${usage_variant:-non-fips}" --link "${usage_link:-static}"

print_success "PKCS#11 conformance suite completed"
