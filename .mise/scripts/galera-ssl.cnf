# Cluster-traffic TLS of the test Galera cluster (docker-compose `galera` profile): the certificates
# are generated by `mr_galera_up` into /cert.
[mysqld]
ssl-ca=/cert/ca.pem
ssl-cert=/cert/server-cert.pem
ssl-key=/cert/server-key.pem

[sst]
encrypt=4
ssl-ca=/cert/ca.pem
ssl-cert=/cert/server-cert.pem
ssl-key=/cert/server-key.pem
