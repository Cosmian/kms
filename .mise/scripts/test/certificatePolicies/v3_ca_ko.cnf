# KO case: X.509v3 extensions WITH certificatePolicies CPS.N:url qualifier.
# This triggers the "no config database" error with the old code path
# (X509Extension::new_nid without an OpenSSL Conf).
#
# Customer error:
#   error:11000088:X509 V3 routines:do_ext_nconf:no config database:crypto/x509/v3_conf.c:118

[ v3_ca ]
basicConstraints=critical,CA:TRUE
subjectKeyIdentifier=hash
keyUsage=crlSign,keyCertSign
certificatePolicies=1.3.6.1.4.1.16376.9.1.1.1.0,CPS.1:http://pkipubpc.cnp.recouv/pc_acoss_reseau_des_urssaf_v4.pdf
