      "user": { "type": "keyword" },
      "object_uid": { "type": "keyword" },
      "algorithm": { "type": "keyword" },
      "client_ip": { "type": "ip" },
      "result_status": { "type": "keyword" },
      "result_detail": { "type": "text" },
      "duration_ms": { "type": "long" },
      "request_id": { "type": "keyword" },
      "prev_hash": { "type": "keyword" },
      "row_hash": { "type": "keyword" }
    }
  }
}
